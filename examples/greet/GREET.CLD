! GREET: one command table for two programs, greet (Rust) and greet.c.
! DCL runs whichever image the logical name GREET_IMAGE names.
MODULE GREET_TABLES

DEFINE VERB GREET
	IMAGE "GREET_IMAGE"
	PARAMETER P1, LABEL=NAMES, PROMPT="Whom", VALUE(REQUIRED, LIST)
	QUALIFIER COUNT, VALUE(TYPE=$NUMBER, DEFAULT="2")
	QUALIFIER LOUD
	QUALIFIER STYLE, VALUE(REQUIRED, TYPE=STYLE_KW)
	QUALIFIER SIGN, VALUE(TYPE=$QUOTED_STRING)
	QUALIFIER SYMBOL, VALUE(REQUIRED)
	DISALLOW LOUD AND STYLE.WHISPER

DEFINE TYPE STYLE_KW
	KEYWORD PLAIN, DEFAULT
	KEYWORD FRAME, VALUE(TYPE=$NUMBER, REQUIRED)
	KEYWORD WHISPER
