$ SET NOON
$ WRITE SYS$OUTPUT "@@ CREATE/FDL=RB.FDL RB.DAT"
$ CREATE/FDL=RB.FDL RB.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ CREATE/FDL=SYS$INPUT RC.DAT"
$ CREATE/FDL=SYS$INPUT RC.DAT
FILE
 ORGANIZATION relative
 MAX_RECORD_NUMBER 20
RECORD
 FORMAT fixed
 SIZE 12
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ fill RB.DAT"
$ OPEN/APPEND f RB.DAT
$ n = 1
$ rl:
$ WRITE f F$FAO("relative !3ZL!28*.", n)
$ n = n + 1
$ IF n .LE. 50 THEN GOTO rl
$ CLOSE f
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE/FDL/OUTPUT=SYS$OUTPUT RB.DAT"
$ ANALYZE/RMS_FILE/FDL/OUTPUT=SYS$OUTPUT RB.DAT
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT RC.DAT"
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT RC.DAT
$ WRITE SYS$OUTPUT "@@ DIRECTORY/FULL RB.DAT,RC.DAT"
$ DIRECTORY/FULL RB.DAT,RC.DAT
$ WRITE SYS$OUTPUT "@@ lexicals RB.DAT"
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("RB.DAT","MRN"), " ", F$FILE_ATTRIBUTES("RB.DAT","EOF"), " ", F$FILE_ATTRIBUTES("RB.DAT","ALQ")
$ WRITE SYS$OUTPUT "@@ CREATE/FDL=SYS$INPUT S.DAT"
$ CREATE/FDL=SYS$INPUT S.DAT
RECORD
	FORMAT	variable
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE/FDL RB.DAT,S.DAT"
$ ANALYZE/RMS_FILE/FDL RB.DAT,S.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE/OUTPUT=Z RB.DAT"
$ ANALYZE/RMS_FILE/OUTPUT=Z RB.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE/FDL/OUTPUT=Y RB.DAT"
$ ANALYZE/RMS_FILE/FDL/OUTPUT=Y RB.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE/CHECK/FDL RB.DAT"
$ ANALYZE/RMS_FILE/CHECK/FDL RB.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE/CHECK/OUTPUT=W RB.DAT,S.DAT"
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=W RB.DAT,S.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE S.DAT,NOSUCH.DAT,RB.DAT"
$ ANALYZE/RMS_FILE S.DAT,NOSUCH.DAT,RB.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE NOSUCH*.DAT"
$ ANALYZE/RMS_FILE NOSUCH*.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ CREATE/DIRECTORY [.SUB]"
$ CREATE/DIRECTORY [.SUB]
$ WRITE SYS$OUTPUT "@@ ANALYZE/RMS_FILE SUB.DIR"
$ ANALYZE/RMS_FILE SUB.DIR
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ DIRECTORY"
$ DIRECTORY
$ WRITE SYS$OUTPUT "@@ TYPE Z.ANL"
$ TYPE Z.ANL
$ WRITE SYS$OUTPUT "@@ TYPE Y.FDL"
$ TYPE Y.FDL
$ WRITE SYS$OUTPUT "@@ TYPE W.ANL"
$ TYPE W.ANL
$ WRITE SYS$OUTPUT "@@ TYPE RB.FDL;2"
$ TYPE RB.FDL;2
$ WRITE SYS$OUTPUT "@@ TYPE S.FDL"
$ TYPE S.FDL
$ WRITE SYS$OUTPUT "@@ CREATE/LOG A.TXT"
$ CREATE/LOG A.TXT
one
$ WRITE SYS$OUTPUT "@@ CREATE/LOG A.TXT"
$ CREATE/LOG A.TXT
two
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ CREATE A.TXT,B.TXT"
$ CREATE A.TXT,B.TXT
three
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ DIRECTORY *.TXT;*"
$ DIRECTORY *.TXT;*
$ WRITE SYS$OUTPUT "@@ TYPE B.TXT"
$ TYPE B.TXT
$ WRITE SYS$OUTPUT "@@ CREATE/DIRECTORY/LOG [.SUB.A.B]"
$ CREATE/DIRECTORY/LOG [.SUB.A.B]
$ WRITE SYS$OUTPUT "@@ CREATE/DIRECTORY/LOG [.SUB.A.B]"
$ CREATE/DIRECTORY/LOG [.SUB.A.B]
$ WRITE SYS$OUTPUT "@@ CREATE/DIRECTORY/LOG [.SUB],[.NEW]"
$ CREATE/DIRECTORY/LOG [.SUB],[.NEW]
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ CREATE/FDL=SEQ.FDL X.DAT"
$ CREATE/FDL=SEQ.FDL X.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ CREATE/FDL=RB.FDL/LOG RB.DAT"
$ CREATE/FDL=RB.FDL/LOG RB.DAT
$ WRITE SYS$OUTPUT "@@ CREATE/FDL=SYS$INPUT/LOG Q.DAT"
$ CREATE/FDL=SYS$INPUT/LOG Q.DAT
FILE
	NAME	"OTHER.DAT"
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ DIRECTORY *.DAT"
$ DIRECTORY *.DAT
$ WRITE SYS$OUTPUT "@@ end"
