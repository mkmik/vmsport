$ CREATE/DIRECTORY SYS$SYSDEVICE:[EDT3]
$ SET DEFAULT SYS$SYSDEVICE:[EDT3]
$ CREATE A.TXT
one
two
three
four
five
*EXIT*
$ CREATE M.TXT
aaa bbb aaa
xx aa
ccc
*EXIT*
$ CREATE Q.TXT
alpha beta gamma delta epsilon
zeta
eta theta iota kappa lambda mu nu xi omicron pi rho

sigma tau upsilon
phi chi psi omega
*EXIT*
$ CREATE T.COM
$ SET NOON
$ WRITE SYS$OUTPUT "@@ subs"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND M.TXT
S/aaa/X/
TYPE WHOLE
S/a/Y/ 2
S/c/Z/ 3/BRIEF
SUBSTITUTE NEXT /zz/q/
SET SEARCH EXACT
S/X/x/WHOLE
S/x/W/WHOLE
QUIT
$ WRITE SYS$OUTPUT "@@ print"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND A.TXT
PRINT P.LIS 2:3
INSERT 3;inserted
PRINT P2.LIS
QUIT
$ DUMP/RECORDS P.LIS
$ DUMP/RECORDS P2.LIS
$ WRITE SYS$OUTPUT "@@ numbers"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND A.TXT
INSERT 2;a
INSERT 2;b
INSERT 2;c
INSERT 2;d
INSERT 2;e
INSERT 2;f
INSERT 2;g
INSERT 2;h
INSERT 2;i
INSERT 2;j
INSERT 2;k
TYPE 1:2
INSERT 1.95;between
TYPE 1.9:2
RESEQUENCE /SEQUENCE:10:5
TYPE 1:30
RESEQUENCE 10:20
TYPE WHOLE
QUIT
$ WRITE SYS$OUTPUT "@@ search"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND A.TXT
FIND 3
TYPE -"three"
TYPE "three"
FIND 3
TYPE -"t"
TYPE "o"
TYPE .+2
TYPE BEGIN+1
TYPE END-1
TYPE "f"+1
TYPE ALL "o" 2:5
TYPE 2:5 ALL "o"
TYPE ALL "zz"
FIND END
TYPE -"e"
QUIT
$ WRITE SYS$OUTPUT "@@ fill"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND Q.TXT
SET WRAP 25
FILL 1:3
TYPE WHOLE
FILL REST
TYPE WHOLE
QUIT
$ EDIT/EDT/NOJOURNAL/NOCOMMAND Q.TXT
FILL WHOLE
TYPE WHOLE
QUIT
$ WRITE SYS$OUTPUT "@@ buffers"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND A.TXT
MOVE 1:2 TO =Y
SHOW BUFFER
TYPE =Y
TYPE =Y WHOLE
TYPE WHOLE
FIND =MAIN
TYPE WHOLE
COPY =Y WHOLE TO =PASTE
TYPE =PASTE WHOLE
CLEAR PASTE
SHOW BUFFER
CLEAR MAIN
SHOW BUFFER
TYPE WHOLE
QUIT/FOO
QUIT
$ WRITE SYS$OUTPUT "@@ misc"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND A.TXT

TYPE
SET TEXT END "<<END>>"
TYPE END
SET NONUMBERS
TYPE 4:END
SET NUMBERS
SET TAB 4
TAB ADJUST 3 2
TAB ADJUST -1 2
TYPE 2
SHOW TAB
SHOW ENTITY WORD
SET ENTITY WORD '+-'
SHOW ENTITY WORD
DEFINE KEY CONTROL X AS "D+L."
SHOW KEY CONTROL X
SHOW KEY CONTROL Y
DEFINE KEY FUNCTION 7 AS "ADV."
DEFINE KEY GOLD CONTROL A AS "D+W."
SHOW KEY GOLD CONTROL A
DEFINE MACRO M1
SHOW BUFFER
COPY 1:2 TO END /DUPLICATE:2
TYPE WHOLE
EXIT ZZ.TXT
$ TYPE ZZ.TXT
$ WRITE SYS$OUTPUT "@@ insert"
$ EDIT/EDT/NOJOURNAL/NOCOMMAND A.TXT
INSERT 2
first inserted
second inserted
$ SHOW SYMBOL $STATUS
$ DIRECTORY A.TXT
$ WRITE SYS$OUTPUT "@@ readonly"
$ EDIT/EDT/READ_ONLY/NOCOMMAND A.TXT
S/one/1/
EXIT R.TXT
$ TYPE R.TXT
$ EDIT/EDT/NOJOURNAL/NOCOMMAND/OUTPUT=O.TXT A.TXT
EXIT O2.TXT
$ DIRECTORY O*.TXT
$ WRITE SYS$OUTPUT "@@ end"
*EXIT*
$ @T
@@ subs
    1       aaa bbb aaa
    1       X bbb aaa
1 substitution
    1       X bbb aaa
    2       xx aa
    3       ccc
[EOB]
    2       xx YY
2 substitutions
    3       ZZZ
3 substitutions
    1       x bbb aaa
1 substitution
    1       W bbb aaa
    2       WW YY
3 substitutions

@@ print
    1       one
    3       three























