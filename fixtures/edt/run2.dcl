SET NONUMBERS
SET CASE UPPER
@@CTRLZ
CREATE P.TXT
The quick brown fox jumps over the lazy dog and keeps on running far away
short
another line of words that wraps
@@CTRLZ
CREATE T.COM
$ SET NOON
$ WRITE SYS$OUTPUT "@@ type"
$ EDIT/EDT/NOJOURNAL A.TXT
TYPE WHOLE
TYPE 2
TYPE 2:4
TYPE 2 THRU 3
TYPE 2 FOR 2
TYPE .
TYPE BEGIN
TYPE END
TYPE REST
TYPE BEFORE
TYPE "fo"
TYPE -"tw"
TYPE ALL "e"
TYPE +1
TYPE -2
TYPE 9
TYPE "zz"
TYPE
T 3
3
TYPE 1,3
QUIT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ insert"
$ EDIT/EDT/NOJOURNAL A.TXT
INSERT 2;new before two
INSERT 2;another
TYPE WHOLE
INSERT END;at end
INSERT BEGIN;at begin
TYPE WHOLE
RESEQUENCE
TYPE WHOLE
REPLACE 3;replaced three
TYPE WHOLE
DELETE 1
DELETE 2:3
TYPE WHOLE
EXIT
$ SHOW SYMBOL $STATUS
$ TYPE A.TXT
$ WRITE SYS$OUTPUT "@@ substitute"
$ EDIT/EDT/NOJOURNAL A.TXT;1
S/o/0/
S/o/0/ WHOLE
TYPE WHOLE
S/zz/y/
S/e/E/ 1:2 /BRIEF
S/e/E/ WHOLE /NOTYPE
TYPE WHOLE
FIND 1
SUBSTITUTE NEXT
SUBSTITUTE NEXT /f/F/
SN
S/i/I/WHOLE
QUIT
$ WRITE SYS$OUTPUT "@@ buffers"
$ EDIT/EDT/NOJOURNAL A.TXT;1
COPY 1:2 TO END
TYPE WHOLE
MOVE 1 TO 4
TYPE WHOLE
COPY 2 TO =X
TYPE =X WHOLE
SHOW BUFFER
FIND =X
TYPE WHOLE
FIND =MAIN
TYPE .
WRITE C.TXT 1:3
INCLUDE B.TXT 2
TYPE WHOLE
CLEAR =X
SHOW BUFFER
EXIT D.TXT
$ TYPE C.TXT
$ TYPE D.TXT
$ WRITE SYS$OUTPUT "@@ errors"
$ EDIT/EDT/NOJOURNAL A.TXT;1
FOO
TYPE 1:
TYPE 3:1
DELETE 99
TYPE 99
MOVE 1 TO 1
SET FOO
SHOW FOO
TYPE "unterminated
EXIT/FOO
TYPE 1 2
QUIT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ show"
$ EDIT/EDT/NOJOURNAL A.TXT;1
SHOW CASE
SHOW CURSOR
SHOW ENTITY
SHOW LINES
SHOW MODE
SHOW NUMBERS
SHOW QUIET
SHOW SCREEN
SHOW SEARCH
SHOW TAB
SHOW TRUNCATE
SHOW VERIFY
SHOW WORD
SHOW WRAP
SHOW VERSION
SHOW FILES
SHOW KEY
SET NUMBERS OFF
TYPE 1:2
SET NUMBERS ON
SET CASE UPPER
TYPE 1:2
SET CASE NONE
SET SEARCH EXACT
TYPE "ONE"
SET SEARCH GENERAL
TYPE "ONE"
SET VERIFY
TYPE 1
SET NOVERIFY
SET QUIET
TYPE 99
SET NOQUIET
QUIT
$ WRITE SYS$OUTPUT "@@ fill"
$ EDIT/EDT/NOJOURNAL P.TXT
SET WRAP 20
FILL WHOLE
TYPE WHOLE
QUIT
$ WRITE SYS$OUTPUT "@@ newfile"
$ EDIT/EDT/NOJOURNAL NEW.TXT
INSERT;hello
EXIT
$ SHOW SYMBOL $STATUS
$ EDIT/EDT/NOJOURNAL EMPTY.TXT
TYPE WHOLE
EXIT
$ SHOW SYMBOL $STATUS
$ EDIT/EDT/NOCREATE/NOJOURNAL NONE.TXT
$ SHOW SYMBOL $STATUS
$ EDIT/EDT/READ_ONLY/NOJOURNAL A.TXT;1
S/one/x/
EXIT
$ SHOW SYMBOL $STATUS
$ EDIT/EDT/OUTPUT=OUT.TXT/NOJOURNAL A.TXT;1
S/one/x/
EXIT
$ EDIT/EDT/COMMAND=INI.EDT/NOJOURNAL A.TXT;1
TYPE 1:2
QUIT
$ EDIT/EDT/NOCOMMAND/NOJOURNAL A.TXT;1
QUIT
$ WRITE SYS$OUTPUT "@@ eof"
$ EDIT/EDT/NOJOURNAL B.TXT
TYPE WHOLE
$ SHOW SYMBOL $STATUS
$ DIRECTORY B.TXT
$ WRITE SYS$OUTPUT "@@ journal"
$ EDIT/EDT A.TXT;1
S/one/J/
QUIT/SAVE
$ DIRECTORY *.JOU
$ EDIT/EDT/RECOVER A.TXT;1
TYPE 1:2
EXIT
$ SHOW SYMBOL $STATUS
$ DIRECTORY *.JOU
$ EDIT/EDT/JOURNAL=MY.JOU A.TXT;1
QUIT/SAVE
$ DIRECTORY *.JOU
$ TYPE A.TXT
$ WRITE SYS$OUTPUT "@@ change"
$ EDIT/EDT/NOJOURNAL A.TXT;1
CHANGE
TYPE 1
QUIT
$ WRITE SYS$OUTPUT "@@ print"
$ EDIT/EDT/NOJOURNAL A.TXT;1
PRINT P1.LIS 2:3
PRINT P2.LIS
SET TAB 4
TAB ADJUST 2 2:3
TYPE 2:3
QUIT
$ TYPE P1.LIS
$ TYPE P2.LIS
$ WRITE SYS$OUTPUT "@@ edtini"
$ COPY EINI.EDT EDTINI.EDT
$ EDIT/EDT/NOJOURNAL A.TXT;1
TYPE 1:2
QUIT
$ DELETE EDTINI.EDT;*
$ WRITE SYS$OUTPUT "@@ save"
$ EDIT/EDT A.TXT;1
S/two/2/WHOLE
EXIT/SAVE
$ DIRECTORY *.JOU
$ EDIT/EDT/NOJOURNAL A.TXT;1
SET LINES 10
SET SCREEN 100
SHOW SCREEN
SET WRAP 30
SHOW WRAP
SET TRUNCATE
SHOW TRUNCATE
SET ENTITY WORD "_ "
SHOW ENTITY
SET SEARCH BEGIN
SHOW SEARCH
SET CURSOR 2:20
SHOW CURSOR
SET MODE CHANGE
SHOW MODE
SET KEYPAD VT100
SHOW KEYPAD
QUIT
$ WRITE SYS$OUTPUT "@@ files"
$ DIRECTORY
$ WRITE SYS$OUTPUT "@@ end"
