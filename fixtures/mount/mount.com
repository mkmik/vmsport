$ SET NOON
$ WRITE SYS$OUTPUT "@@ dismount"
$ DISMOUNT DKA100:
$ SHOW SYMBOL $STATUS
$ DISMOUNT DKA100:
$ SHOW SYMBOL $STATUS
$ DISMOUNT DKA300:
$ SHOW SYMBOL $STATUS
$ DISMOUNT NOSUCH:
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ mount"
$ MOUNT/NOASSIST/OVERRIDE=IDENTIFICATION/NOWRITE DKA100:
$ SHOW SYMBOL $STATUS
$ SHOW LOGICAL DISK$VPTIN
$ MOUNT/NOASSIST/OVERRIDE=IDENTIFICATION/NOWRITE DKA100:
$ SHOW SYMBOL $STATUS
$ MOUNT/NOASSIST/NOWRITE DKA100: VPTIN
$ SHOW SYMBOL $STATUS
$ DISMOUNT DKA100:
$ MOUNT/NOASSIST/NOWRITE DKA100: WRONG
$ SHOW SYMBOL $STATUS
$ MOUNT/NOASSIST/NOWRITE DKA100: VPTIN
$ SHOW SYMBOL $STATUS
$ SHOW LOGICAL DISK$VPTIN
$ DISMOUNT DKA100:
$ MOUNT/NOASSIST/NOWRITE DKA100: VPTIN MYDISK
$ SHOW SYMBOL $STATUS
$ SHOW LOGICAL MYDISK
$ DIRECTORY MYDISK:[T]
$ DISMOUNT DKA100:
$ SHOW LOGICAL MYDISK
$ MOUNT/NOASSIST DKA300: X
$ SHOW SYMBOL $STATUS
$ MOUNT/NOASSIST/OVERRIDE=IDENTIFICATION/NOWRITE DKA100:
$ WRITE SYS$OUTPUT "@@ end"
