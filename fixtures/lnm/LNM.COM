$! Logical names, for vms-lnm: what DEFINE, ASSIGN, DEASSIGN and
$! CREATE/NAME_TABLE do, as SHOW LOGICAL, F$TRNLNM and F$PARSE see it.
$! Each case starts with "@@ name".
$ SET NOON
$ WRITE SYS$OUTPUT "@@ simple"
$ DEFINE VPT_ONE "first value"
$ SHOW LOGICAL VPT_ONE
$ SHOW LOGICAL/FULL VPT_ONE
$ WRITE SYS$OUTPUT "@@ upcased"
$ DEFINE vpt_up lower value
$ SHOW LOGICAL VPT_UP
$ WRITE SYS$OUTPUT "@@ assign"
$ ASSIGN "assigned" VPT_ASG
$ SHOW LOGICAL VPT_ASG
$ WRITE SYS$OUTPUT "@@ supersede"
$ DEFINE VPT_ONE "second value"
$ SHOW LOGICAL VPT_ONE
$ WRITE SYS$OUTPUT "@@ nolog"
$ DEFINE/NOLOG VPT_ONE "third value"
$ SHOW LOGICAL VPT_ONE
$ WRITE SYS$OUTPUT "@@ chain"
$ DEFINE VPT_TWO VPT_ONE
$ DEFINE VPT_THREE VPT_TWO
$ SHOW LOGICAL VPT_THREE
$ SHOW LOGICAL/FULL VPT_THREE
$ WRITE SYS$OUTPUT "@@ search list"
$ DEFINE VPT_LIST "alpha","Beta",gamma
$ SHOW LOGICAL VPT_LIST
$ SHOW LOGICAL/FULL VPT_LIST
$ WRITE SYS$OUTPUT "@@ search list chain"
$ DEFINE VPT_LISTREF VPT_LIST
$ SHOW LOGICAL VPT_LISTREF
$ WRITE SYS$OUTPUT "@@ terminal"
$ DEFINE/TRANSLATION_ATTRIBUTES=TERMINAL VPT_TERM VPT_ONE
$ SHOW LOGICAL VPT_TERM
$ SHOW LOGICAL/FULL VPT_TERM
$ WRITE SYS$OUTPUT "@@ concealed"
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) VPT_CONC "DKA200:[T.LNM.]"
$ SHOW LOGICAL VPT_CONC
$ SHOW LOGICAL/FULL VPT_CONC
$ WRITE SYS$OUTPUT "@@ per value attributes"
$ DEFINE VPT_MIX "a"/TRANSLATION_ATTRIBUTES=CONCEALED,"b"
$ SHOW LOGICAL/FULL VPT_MIX
$ WRITE SYS$OUTPUT "@@ name attributes"
$ DEFINE/NAME_ATTRIBUTES=(NO_ALIAS,CONFINE) VPT_NA "x"
$ SHOW LOGICAL/FULL VPT_NA
$ WRITE SYS$OUTPUT "@@ modes"
$ DEFINE/EXECUTIVE_MODE VPT_EXEC "exec"
$ DEFINE/SUPERVISOR_MODE VPT_SUP "sup"
$ SHOW LOGICAL/FULL VPT_EXEC
$ SHOW LOGICAL/FULL VPT_SUP
$ WRITE SYS$OUTPUT "@@ job"
$ DEFINE/JOB VPT_JOBNAME "job value"
$ SHOW LOGICAL VPT_JOBNAME
$ WRITE SYS$OUTPUT "@@ group"
$ DEFINE/GROUP VPT_GRP "group value"
$ SHOW LOGICAL VPT_GRP
$ SHOW LOGICAL/FULL VPT_GRP
$ WRITE SYS$OUTPUT "@@ system"
$ DEFINE/SYSTEM VPT_SYS "system value"
$ SHOW LOGICAL/FULL VPT_SYS
$ WRITE SYS$OUTPUT "@@ shadowed"
$ DEFINE/SYSTEM VPT_BOTH "in system"
$ DEFINE VPT_BOTH "in process"
$ SHOW LOGICAL VPT_BOTH
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_BOTH")
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_BOTH", "LNM$SYSTEM")
$ WRITE SYS$OUTPUT "@@ wildcard"
$ SHOW LOGICAL VPT_L*
$ SHOW LOGICAL/PROCESS VPT_T*
$ WRITE SYS$OUTPUT "@@ table"
$ CREATE/NAME_TABLE VPT_TAB
$ DEFINE/TABLE=VPT_TAB VPT_INTAB "in table"
$ DEFINE/TABLE=VPT_TAB VPT_INTAB2 "also in table"
$ SHOW LOGICAL/TABLE=VPT_TAB
$ SHOW LOGICAL/TABLE=VPT_TAB VPT_INTAB
$ SHOW LOGICAL/FULL/TABLE=LNM$PROCESS_DIRECTORY VPT_TAB
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_INTAB"), "]"
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_INTAB", "VPT_TAB")
$ WRITE SYS$OUTPUT "@@ table search list"
$ DEFINE/TABLE=LNM$PROCESS_DIRECTORY VPT_SEARCH VPT_TAB,LNM$PROCESS_TABLE
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_INTAB", "VPT_SEARCH")
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_ONE", "VPT_SEARCH")
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_INTAB", "VPT_SEARCH",,,, "TABLE_NAME")
$ SHOW LOGICAL/TABLE=VPT_SEARCH VPT_INTAB
$ SHOW LOGICAL/FULL/TABLE=LNM$PROCESS_DIRECTORY VPT_SEARCH
$ WRITE SYS$OUTPUT "@@ directories"
$ SHOW LOGICAL/FULL/TABLE=LNM$SYSTEM_DIRECTORY LNM$FILE_DEV
$ SHOW LOGICAL/FULL/TABLE=LNM$SYSTEM_DIRECTORY LNM$DCL_LOGICAL
$ SHOW LOGICAL/FULL/TABLE=LNM$PROCESS_DIRECTORY LNM$PROCESS
$ SHOW LOGICAL/FULL/TABLE=LNM$SYSTEM_DIRECTORY LNM$SYSTEM
$ SHOW LOGICAL/FULL/TABLE=LNM$SYSTEM_DIRECTORY LNM$GROUP
$ SHOW LOGICAL/FULL/TABLE=LNM$PROCESS_DIRECTORY LNM$PROCESS_TABLE
$ SHOW LOGICAL/FULL/TABLE=LNM$SYSTEM_DIRECTORY LNM$SYSTEM_TABLE
$ WRITE SYS$OUTPUT "@@ items"
$ CALL items VPT_ONE
$ CALL items VPT_LIST
$ CALL items VPT_TERM
$ CALL items VPT_CONC
$ CALL items VPT_MIX
$ CALL items VPT_NA
$ CALL items VPT_EXEC
$ CALL items VPT_SYS
$ CALL items VPT_INTAB VPT_TAB
$ CALL items VPT_NONE
$ WRITE SYS$OUTPUT "@@ index"
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_LIST",,0), F$TRNLNM("VPT_LIST",,1), -
	F$TRNLNM("VPT_LIST",,2), "[", F$TRNLNM("VPT_LIST",,3), "]"
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_MIX",,1,,,"CONCEALED"), " ", -
	F$TRNLNM("VPT_MIX",,0,,,"CONCEALED"), " ", F$TRNLNM("VPT_MIX",,0,,,"LENGTH")
$ WRITE SYS$OUTPUT "@@ modes in F$TRNLNM"
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_ONE",,,"EXECUTIVE"), "] [", -
	F$TRNLNM("VPT_EXEC",,,"EXECUTIVE"), "] [", F$TRNLNM("VPT_EXEC",,,"KERNEL"), "]"
$ WRITE SYS$OUTPUT "@@ case"
$ DEFINE "VptMixed" "case sensitive name"
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VptMixed"), "] [", F$TRNLNM("VPTMIXED"), -
	"] [", F$TRNLNM("vptmixed",,,,"CASE_BLIND"), "]"
$ SHOW LOGICAL "VptMixed"
$ WRITE SYS$OUTPUT "@@ undefined"
$ SHOW LOGICAL VPT_NONE
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_NONE"), "]"
$ DEASSIGN VPT_NONE
$ WRITE SYS$OUTPUT "@@ deassign"
$ DEASSIGN VPT_ASG
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_ASG"), "]"
$ DEASSIGN/SYSTEM VPT_BOTH
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_BOTH", "LNM$SYSTEM"), "] [", F$TRNLNM("VPT_BOTH"), "]"
$ DEASSIGN/TABLE=VPT_TAB VPT_INTAB2
$ SHOW LOGICAL/TABLE=VPT_TAB
$ WRITE SYS$OUTPUT "@@ rooted"
$ CREATE/DIRECTORY DKA200:[T.LNM.SUB]
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED VPT_ROOT DKA200:[T.LNM.]
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT:[SUB]X.Y")
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT:[SUB]X.Y",,,,"NO_CONCEAL")
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT:[SUB]X.Y",,,"DEVICE"), " ", -
	F$PARSE("VPT_ROOT:[SUB]X.Y",,,"DIRECTORY")
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT:[000000]X.Y")
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT:X.Y")
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT:[SUB.NOSUCH]X.Y"), "|"
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT:[SUB.NOSUCH]X.Y",,,,"SYNTAX_ONLY")
$ DEFINE VPT_ROOT2 DKA200:[T.LNM.]
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT2:[SUB]X.Y")
$ WRITE SYS$OUTPUT F$PARSE("VPT_ROOT2:[SUB]X.Y",,,,"NO_CONCEAL")
$ DEFINE VPT_DEV VPT_ROOT:
$ WRITE SYS$OUTPUT F$PARSE("VPT_DEV:[SUB]X.Y")
$ DEFINE VPT_SUBDIR VPT_ROOT:[SUB]
$ WRITE SYS$OUTPUT F$PARSE("VPT_SUBDIR:X.Y")
$ WRITE SYS$OUTPUT F$PARSE("VPT_SUBDIR:X.Y",,,,"NO_CONCEAL")
$ DEFINE VPT_FILE VPT_ROOT:[SUB]Z.DAT
$ WRITE SYS$OUTPUT F$PARSE("VPT_FILE")
$ WRITE SYS$OUTPUT F$PARSE("VPT_FILE",,,,"NO_CONCEAL")
$ DEFINE VPT_PLAIN DKA200:[T.LNM.SUB]
$ WRITE SYS$OUTPUT F$PARSE("VPT_PLAIN:X.Y")
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED VPT_CDEV DKA200:
$ WRITE SYS$OUTPUT F$PARSE("VPT_CDEV:[T.LNM.SUB]X.Y")
$ SET DEFAULT VPT_ROOT:[SUB]
$ SHOW DEFAULT
$ WRITE SYS$OUTPUT F$ENVIRONMENT("DEFAULT")
$ WRITE SYS$OUTPUT F$PARSE("X.Y")
$ SET DEFAULT VPT_ROOT:[000000]
$ SHOW DEFAULT
$ SET DEFAULT DKA200:[T.LNM]
$ WRITE SYS$OUTPUT "@@ end"
$ EXIT 1
$!
$items: SUBROUTINE
$ IF P2 .EQS. "" THEN P2 = "LNM$DCL_LOGICAL"
$ i = 0
$loop:
$ item = F$ELEMENT(i, ",", -
	"VALUE,LENGTH,MAX_INDEX,TABLE,TABLE_NAME,TERMINAL,CONCEALED,CONFINE,NO_ALIAS,CRELOG,ACCESS_MODE")
$ IF item .EQS. "," THEN EXIT
$ WRITE SYS$OUTPUT P1, " ", item, " [", F$TRNLNM(P1, P2,,,, item), "]"
$ i = i + 1
$ GOTO loop
$ ENDSUBROUTINE
