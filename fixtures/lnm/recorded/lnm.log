   "LNM$DCL_LOGICAL" [super] = "LNM$FILE_DEV" (LNM$SYSTEM_DIRECTORY)
1  "LNM$FILE_DEV" [super] = "LNM$PROCESS" (LNM$SYSTEM_DIRECTORY)
	= "LNM$JOB"
	= "LNM$GROUP"
	= "LNM$SYSTEM"
2  "LNM$SYSTEM" [kernel,no_alias] = "LNM$SYSTEM_TABLE" [terminal] (LNM$SYSTEM_DIRECTORY)
	= "LNM$SYSCLUSTER"
3  "LNM$SYSCLUSTER" [kernel,no_alias] = "LNM$SYSCLUSTER_TABLE" [terminal] (LNM$SYSTEM_DIRECTORY)
   "LNM$PROCESS" [kernel] = "LNM$PROCESS_TABLE" [terminal] (LNM$PROCESS_DIRECTORY)
   "LNM$SYSTEM" [kernel,no_alias] = "LNM$SYSTEM_TABLE" [terminal] (LNM$SYSTEM_DIRECTORY)
	= "LNM$SYSCLUSTER"
1  "LNM$SYSCLUSTER" [kernel,no_alias] = "LNM$SYSCLUSTER_TABLE" [terminal] (LNM$SYSTEM_DIRECTORY)
