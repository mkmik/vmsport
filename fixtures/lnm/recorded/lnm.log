@@ simple
   "VPT_ONE" = "first value" (LNM$PROCESS_TABLE)
   "VPT_ONE" [super] = "first value" (LNM$PROCESS_TABLE)
@@ upcased
%DCL-W-MAXPARM, too many parameters - reenter command with fewer parameters
 \VALUE\
%SHOW-S-NOTRAN, no translation for logical name VPT_UP
@@ assign
   "VPT_ASG" = "assigned" (LNM$PROCESS_TABLE)
@@ supersede
%DCL-I-SUPERSEDE, previous value of VPT_ONE has been superseded
   "VPT_ONE" = "second value" (LNM$PROCESS_TABLE)
@@ nolog
   "VPT_ONE" = "third value" (LNM$PROCESS_TABLE)
@@ chain
   "VPT_THREE" = "VPT_TWO" (LNM$PROCESS_TABLE)
1  "VPT_TWO" = "VPT_ONE" (LNM$PROCESS_TABLE)
2  "VPT_ONE" = "third value" (LNM$PROCESS_TABLE)
   "VPT_THREE" [super] = "VPT_TWO" (LNM$PROCESS_TABLE)
1  "VPT_TWO" [super] = "VPT_ONE" (LNM$PROCESS_TABLE)
2  "VPT_ONE" [super] = "third value" (LNM$PROCESS_TABLE)
@@ search list
   "VPT_LIST" = "alpha" (LNM$PROCESS_TABLE)
	= "Beta"
	= "GAMMA"
   "VPT_LIST" [super] = "alpha" (LNM$PROCESS_TABLE)
	= "Beta"
	= "GAMMA"
@@ search list chain
   "VPT_LISTREF" = "VPT_LIST" (LNM$PROCESS_TABLE)
1  "VPT_LIST" = "alpha" (LNM$PROCESS_TABLE)
	= "Beta"
	= "GAMMA"
@@ terminal
   "VPT_TERM" = "VPT_ONE" (LNM$PROCESS_TABLE)
   "VPT_TERM" [super] = "VPT_ONE" [terminal] (LNM$PROCESS_TABLE)
@@ concealed
   "VPT_CONC" = "DKA200:[T.LNM.]" (LNM$PROCESS_TABLE)
   "VPT_CONC" [super] = "DKA200:[T.LNM.]" [concealed,terminal] (LNM$PROCESS_TABLE)
@@ per value attributes
   "VPT_MIX" [super] = "a" [concealed] (LNM$PROCESS_TABLE)
	= "b"
@@ name attributes
   "VPT_NA" [super,confine,no_alias] = "x" (LNM$PROCESS_TABLE)
@@ modes
   "VPT_EXEC" [exec] = "exec" (LNM$PROCESS_TABLE)
   "VPT_SUP" [super] = "sup" (LNM$PROCESS_TABLE)
@@ job
   "VPT_JOBNAME" = "job value" (LNM$JOB_80CB54C0)
@@ group
   "VPT_GRP" = "group value" (LNM$GROUP_000001)
   "VPT_GRP" [super] = "group value" (LNM$GROUP_000001)
@@ system
   "VPT_SYS" [super] = "system value" (LNM$SYSTEM_TABLE)
@@ shadowed
   "VPT_BOTH" = "in process" (LNM$PROCESS_TABLE)
   "VPT_BOTH" = "in system" (LNM$SYSTEM_TABLE)
in process
in system
@@ wildcard

(LNM$PROCESS_TABLE)

  "VPT_LIST" = "alpha"
	= "Beta"
	= "GAMMA"
  "VPT_LISTREF" = "VPT_LIST"

(LNM$JOB_80CB54C0)

(LNM$GROUP_000001)

(LNM$SYSTEM_TABLE)

(LNM$SYSCLUSTER_TABLE)

(LNM$PROCESS_TABLE)

  "VPT_TERM" = "VPT_ONE"
  "VPT_THREE" = "VPT_TWO"
  "VPT_TWO" = "VPT_ONE"
@@ table

(VPT_TAB)

  "VPT_INTAB" = "in table"
  "VPT_INTAB2" = "also in table"
   "VPT_INTAB" = "in table" (VPT_TAB)
   "VPT_TAB" [super,table] = "" [terminal] (LNM$PROCESS_DIRECTORY)
[]
in table
@@ table search list
in table
third value
VPT_TAB
   "VPT_INTAB" = "in table" (VPT_TAB)
