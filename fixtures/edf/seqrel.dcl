SET DEFAULT SYS$LOGIN
CREATE/DIRECTORY [.EDS]
SET DEFAULT [.EDS]
CREATE IDX.FDL
FILE
  ORGANIZATION indexed
RECORD
  FORMAT fixed
  SIZE 64
KEY 0
  SEG0_LENGTH 8
  SEG0_POSITION 0
  DUPLICATES no
  CHANGES no
KEY 1
  SEG0_LENGTH 10
  SEG0_POSITION 8
  DUPLICATES yes
  CHANGES yes
@@CTRLZ
CREATE SMALL.FDL
FILE
  ORGANIZATION sequential
@@CTRLZ
@@KEY EDIT/FDL/SCRIPT=SEQUENTIAL S1.FDL
@@AUTO
@@KEY ^Z
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=SEQUENTIAL S2.FDL
@@AUTO Capacity=50000 Size=200
@@KEY ^Z
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=RELATIVE R1.FDL
@@AUTO
@@KEY ^Z
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=RELATIVE R2.FDL
@@AUTO Capacity=200 Size=33
@@KEY ^Z
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL SMALL.FDL
@@KEY INVOKE
@@KEY SEQUENTIAL
@@AUTO
@@KEY VIEW
@@KEY ^Z
SHOW SYMBOL $STATUS
DIRECTORY
TYPE S1.FDL;*
TYPE S2.FDL;*
TYPE R1.FDL;*
TYPE R2.FDL;*
TYPE SMALL.FDL;*
