SET DEFAULT SYS$LOGIN
CREATE/DIRECTORY [.EDF5]
SET DEFAULT [.EDF5]
CREATE D1A.FDL
FILE
  CLUSTER_SIZE 1
  ORGANIZATION indexed
@@CTRLZ
