$ SET DEFAULT SYS$LOGIN
$ CREATE/DIRECTORY [.EDF1]
$ SET DEFAULT [.EDF1]
$ CREATE SEQ.FDL
FILE
  ORGANIZATION sequential
RECORD
  CARRIAGE_CONTROL carriage_return
  FORMAT variable
  SIZE 0
*EXIT*
$ CREATE REL.FDL
FILE
  ORGANIZATION relative
RECORD
  FORMAT fixed
  SIZE 40
*EXIT*
$ CREATE IDX.FDL
FILE
  ORGANIZATION indexed
RECORD
  FORMAT fixed
  SIZE 64
KEY 0
  SEG0_LENGTH 8
  SEG0_POSITION 0
  DUPLICATES no
  CHANGES no
KEY 1
  SEG0_LENGTH 10
  SEG0_POSITION 8
  DUPLICATES yes
  CHANGES yes
*EXIT*
$ CREATE IDV.FDL
FILE
  ORGANIZATION indexed
RECORD
  FORMAT variable
  SIZE 200
KEY 0
  SEG0_LENGTH 6
  SEG0_POSITION 0
  SEG1_LENGTH 4
  SEG1_POSITION 20
KEY 1
  SEG0_LENGTH 8
  SEG0_POSITION 6
  DUPLICATES yes
KEY 2
  SEG0_LENGTH 6
  SEG0_POSITION 14
  DUPLICATES yes
  CHANGES yes
*EXIT*
$ CREATE BAD.FDL
FILE
  ORGANIZATION indexed
  BOGUS 3
*EXIT*
$ CREATE RUN.COM
$ SET NOON
$ SET TERMINAL/TAB
$ CREATE/FDL=SEQ.FDL SEQ.DAT
$ CALL load SEQ.DAT 500 SEQ
$ CREATE/FDL=REL.FDL REL.DAT
$ CALL load REL.DAT 500 REL
$ CREATE/FDL=IDX.FDL IDX.DAT
$ CALL load IDX.DAT 1000 IDX
$ CREATE/FDL=IDX.FDL IDS.DAT
$ CALL load IDS.DAT 10 IDX
$ CREATE/FDL=IDV.FDL IDV.DAT
$ CALL load IDV.DAT 3000 IDV
$ ANALYZE/RMS_FILE/FDL/OUTPUT=SEQA.FDL SEQ.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=RELA.FDL REL.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=IDXA.FDL IDX.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=IDSA.FDL IDS.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=IDVA.FDL IDV.DAT
$ WRITE SYS$OUTPUT "@@ statuses"
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=SEQA.FDL/OUTPUT=SEQO.FDL SEQ.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=RELA.FDL/OUTPUT=RELO.FDL REL.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDXA.FDL/OUTPUT=IDXO.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDSA.FDL/OUTPUT=IDSO.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDVA.FDL/OUTPUT=IDVO.FDL IDV.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDXA.FDL/OUTPUT=IDXSB.FDL/EMPHASIS=SMALLER_BUFFERS IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDXA.FDL/OUTPUT=IDXG4.FDL/GRANULARITY=4 IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDXA.FDL/OUTPUT=IDXSELF.FDL IDXA.FDL
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ errors"
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=NOSUCH.FDL/OUTPUT=E1.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDXA.FDL/OUTPUT=E2.FDL NOSUCH.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDXA.FDL/OUTPUT=E3.FDL BAD.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=BAD.FDL/OUTPUT=E4.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=SEQA.FDL/OUTPUT=E5.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/OUTPUT=E6.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/SCRIPT=INDEXED/OUTPUT=E7.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS/OUTPUT=E8.FDL IDXA.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=IDXA.FDL/OUTPUT=E9.FDL SEQ.FDL
$ SHOW SYMBOL $STATUS
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS=RELA.FDL/OUTPUT=E10.FDL IDX.FDL
$ SHOW SYMBOL $STATUS
$ DIRECTORY
$ CALL show SEQA.FDL
$ CALL show SEQO.FDL
$ CALL show RELA.FDL
$ CALL show RELO.FDL
$ CALL show IDXA.FDL
$ CALL show IDXO.FDL
$ CALL show IDSA.FDL
$ CALL show IDSO.FDL
$ CALL show IDVA.FDL
$ CALL show IDVO.FDL
$ CALL show IDXSB.FDL
$ CALL show IDXG4.FDL
$ CALL show IDXSELF.FDL
$ CALL show E1.FDL
$ CALL show E2.FDL
$ CALL show E3.FDL
$ CALL show E4.FDL
$ CALL show E5.FDL
$ CALL show E6.FDL
$ CALL show E7.FDL
$ CALL show E8.FDL
$ CALL show E9.FDL
$ CALL show E10.FDL
$ WRITE SYS$OUTPUT "@@ end"
$ EXIT
$load: SUBROUTINE
$ n = 1
$ max = F$INTEGER(P2)
$ pad = F$FAO("!200*x")
$ IF P3 .EQS. "SEQ" THEN OPEN/APPEND f 'P1'
$ IF P3 .NES. "SEQ" THEN OPEN/READ/WRITE f 'P1'
$l:
$ k = n * 37 - (n * 37 / 10007) * 10007
$ IF P3 .EQS. "IDX" THEN WRITE f F$FAO("ID!6ZLCITY!6ZL!46AS", k, k - (k / 50) * 50, "x")
$ v = F$FAO("K!5ZLC!7ZL!6ZL!4ZL", k, k - (k / 37) * 37, k - (k / 1000) * 1000, n - (n / 10) * 10)
$ IF P3 .EQS. "IDV" THEN WRITE f v + F$EXTRACT(0, k - (k / 80) * 80, pad)
$ IF P3 .EQS. "SEQ" THEN WRITE f F$EXTRACT(0, k - (k / 90) * 90, pad)
$ IF P3 .EQS. "REL" THEN WRITE f F$FAO("!40AS", F$STRING(k))
$ n = n + 1
$ IF n .LE. max THEN GOTO l
$ CLOSE f
$ ENDSUBROUTINE
$show: SUBROUTINE
$ WRITE SYS$OUTPUT "@@ ", P1
$ TYPE 'P1'
$ ENDSUBROUTINE
*EXIT*
$ @RUN
