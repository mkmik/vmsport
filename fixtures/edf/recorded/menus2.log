$ SET DEFAULT SYS$LOGIN
$ CREATE/DIRECTORY [.EDM2]
$ SET DEFAULT [.EDM2]
$ CREATE IDX.FDL
FILE
  ORGANIZATION indexed
RECORD
  FORMAT fixed
  SIZE 64
KEY 0
  SEG0_LENGTH 8
  SEG0_POSITION 0
  DUPLICATES no
  CHANGES no
KEY 1
  SEG0_LENGTH 10
  SEG0_POSITION 8
  DUPLICATES yes
  CHANGES yes
*EXIT*
$ CREATE SMALL.FDL
FILE
  ORGANIZATION sequential
*EXIT*
$ COPY IDX.FDL M5.FDL
$ COPY IDX.FDL M6.FDL
$ COPY IDX.FDL M7.FDL
$ COPY SMALL.FDL M8.FDL
$ EDIT/FDL M5.FDL
