SET DEFAULT SYS$LOGIN
CREATE/DIRECTORY [.EDM]
SET DEFAULT [.EDM]
CREATE IDX.FDL
FILE
  ORGANIZATION indexed
RECORD
  FORMAT fixed
  SIZE 64
KEY 0
  SEG0_LENGTH 8
  SEG0_POSITION 0
  DUPLICATES no
  CHANGES no
KEY 1
  SEG0_LENGTH 10
  SEG0_POSITION 8
  DUPLICATES yes
  CHANGES yes
@@CTRLZ
CREATE SMALL.FDL
FILE
  ORGANIZATION sequential
@@CTRLZ
COPY IDX.FDL M1.FDL
COPY IDX.FDL M2.FDL
COPY IDX.FDL M3.FDL
COPY IDX.FDL M4.FDL
@@KEY EDIT/FDL SMALL.FDL
@@KEY VIEW
@@KEY V
