SET DEFAULT SYS$LOGIN
CREATE/DIRECTORY [.EDI]
SET DEFAULT [.EDI]
CREATE IDX.FDL
FILE
  ORGANIZATION indexed
RECORD
  FORMAT fixed
  SIZE 64
KEY 0
  SEG0_LENGTH 8
  SEG0_POSITION 0
  DUPLICATES no
  CHANGES no
KEY 1
  SEG0_LENGTH 10
  SEG0_POSITION 8
  DUPLICATES yes
  CHANGES yes
@@CTRLZ
@@KEY EDIT/FDL/SCRIPT=INDEXED I1.FDL
@@AUTO Length=8 Size=64
@@END
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=INDEXED I2.FDL
@@AUTO stop=Number
@@KEY 2
@@AUTO File=50000 stop=Format
@@KEY F
@@AUTO Size=100 Length=10 Position=20
@@END
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=INDEXED I3.FDL
@@AUTO Length=8 Size=64 stop=Mnemonic
@@KEY BF
@@KEY 80
@@KEY KL
@@KEY 20
@@KEY IL
@@KEY 100000
@@KEY 
@@KEY ?
@@AUTO
@@END
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=INDEXED I4.FDL
@@AUTO stop=Graph
@@KEY Fill
@@AUTO Length=8 Size=64
@@END
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=INDEXED I5.FDL
@@AUTO Size=64 stop=Segmentation
@@KEY Yes
@@AUTO stop=Length
@@KEY 4
@@AUTO stop=Length
@@KEY 6
@@AUTO stop=Length
@@KEY 0
@@AUTO
@@END
SHOW SYMBOL $STATUS
@@KEY EDIT/FDL/SCRIPT=INDEXED I6.FDL
@@AUTO Length=8 Size=64 stop=Title
@@KEY A title for the file
@@KEY DKA0:[X]DATA.IDX
@@KEY F
@@AUTO stop=pre-V8.3
@@KEY Yes
@@AUTO
@@END
SHOW SYMBOL $STATUS
DIRECTORY
TYPE I1.FDL;*
TYPE I2.FDL;*
TYPE I3.FDL;*
TYPE I4.FDL;*
TYPE I5.FDL;*
TYPE I6.FDL;*
