CREATE RUN.COM
$ SET NOON
$ SET TERMINAL/TAB
$ GOSUB base
$ n0 = 230000
$ CALL case X00 D1A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 250000
$ CALL case X01 D1A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 260000
$ CALL case X02 D1A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 270000
$ CALL case X03 D1A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 280000
$ CALL case X04 D1A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 1000
$ CALL case Y00 D1C3A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 3000
$ CALL case Y01 D1C3A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 5000
$ CALL case Y02 D1C3A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 1000
$ CALL case Y03 D1C4A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 3000
$ CALL case Y04 D1C4A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 7000
$ CALL case Y05 D1C4A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 30000
$ CALL case Y06 D1C4A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 10000
$ CALL case Y07 D1C7A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 100000
$ CALL case Y08 D1C7A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 50000
$ CALL case Y09 D1C16A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 70000
$ CALL case Y10 D1C16A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 150000
$ CALL case Y11 D1C16A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 200000
$ CALL case Y12 D1C16A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 100000
$ CALL case M00 D1MA.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 100000
$ CALL case M01 D1MC16A.FDL D1.FDL "" 1
$ GOSUB base
$ n0 = 10000
$ CALL case M02 D1MC16A.FDL D1.FDL "" 1
$ WRITE SYS$OUTPUT "@@ end"
$ EXIT
$base:
$ n0 = 1000
$ df0 = 72
$ dkc0 = 49
$ drc0 = 73
$ dso0 = 94
$ dep0 = 1
$ ic0 = 28
$ if0 = 34
$ iso0 = 2
$ l10 = 47
$ mdl0 = 64
$ mil0 = 10
$ lrl0 = 64
$ n1 = 50
$ df1 = 66
$ dkc1 = 56
$ dso1 = 16
$ dep1 = 1
$ dps1 = 19
$ ic1 = 44
$ if1 = 6
$ iso1 = 2
$ l11 = 8
$ mdl1 = 106
$ mil1 = 12
$ n2 = 50
$ df2 = 66
$ dkc2 = 56
$ dso2 = 16
$ dep2 = 1
$ dps2 = 19
$ ic2 = 44
$ if2 = 6
$ iso2 = 2
$ l12 = 8
$ mdl2 = 106
$ mil2 = 12
$ n3 = 50
$ df3 = 66
$ dkc3 = 56
$ dso3 = 16
$ dep3 = 1
$ dps3 = 19
$ ic3 = 44
$ if3 = 6
$ iso3 = 2
$ l13 = 8
$ mdl3 = 106
$ mil3 = 12
$ RETURN
$case: SUBROUTINE
$ SET NOON
$ OPEN/WRITE t T.TMP
$ WRITE t ""
$ WRITE t "ANALYSIS_OF_AREA 0"
$ WRITE t "  RECLAIMED_SPACE 0"
$ CALL aok 0
$ IF P5 .GT. 1 THEN CALL aok 1
$ IF P5 .GT. 2 THEN CALL aok 2
$ IF P5 .GT. 3 THEN CALL aok 3
$ CLOSE t
$ COPY 'P2'+T.TMP 'P1'A.FDL
$ DELETE T.TMP;*
$ EDIT/FDL/NOINTERACTIVE/ANALYSIS='P1'A.FDL/OUTPUT='P1'O.FDL'P4' 'P3'
$ st = $STATUS
$ WRITE SYS$OUTPUT "@@ ", P1, " ", P3, " ", P4, " ", F$FAO("!XL", F$INTEGER(st))
$ TYPE 'P1'A.FDL
$ WRITE SYS$OUTPUT "@@ ", P1, " output"
$ TYPE 'P1'O.FDL
$ ENDSUBROUTINE
$aok: SUBROUTINE
$ WRITE t ""
$ WRITE t "ANALYSIS_OF_KEY ", P1
$ WRITE t "  DATA_FILL ", df'P1'
$ WRITE t "  DATA_KEY_COMPRESSION ", dkc'P1'
$ IF P1 .EQ. 0 THEN WRITE t "  DATA_RECORD_COMPRESSION ", drc0
$ WRITE t "  DATA_RECORD_COUNT ", n'P1'
$ WRITE t "  DATA_SPACE_OCCUPIED ", dso'P1'
$ WRITE t "  DEPTH ", dep'P1'
$ IF P1 .GT. 0 THEN WRITE t "  DUPLICATES_PER_SIDR ", dps'P1'
$ WRITE t "  INDEX_COMPRESSION ", ic'P1'
$ WRITE t "  INDEX_FILL ", if'P1'
$ WRITE t "  INDEX_SPACE_OCCUPIED ", iso'P1'
$ WRITE t "  LEVEL1_RECORD_COUNT ", l1'P1'
$ WRITE t "  MEAN_DATA_LENGTH ", mdl'P1'
$ WRITE t "  MEAN_INDEX_LENGTH ", mil'P1'
$ IF P1 .EQ. 0 THEN WRITE t "  LONGEST_RECORD_LENGTH ", lrl0
$ ENDSUBROUTINE
@@CTRLZ
@RUN
