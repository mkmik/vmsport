SET DEFAULT SYS$LOGIN
CREATE/DIRECTORY [.EDF4C]
SET DEFAULT [.EDF4C]
CREATE E1.FDL
FILE
  ORGANIZATION indexed
RECORD
  FORMAT fixed
  SIZE 64
KEY 0
  SEG0_LENGTH 8
  SEG0_POSITION 0
  DUPLICATES no
  CHANGES no
KEY 1
  SEG0_LENGTH 10
  SEG0_POSITION 8
  DUPLICATES yes
  CHANGES yes
@@CTRLZ
CREATE E1MA.FDL
FILE
  CLUSTER_SIZE 1
  ORGANIZATION indexed
@@CTRLZ
