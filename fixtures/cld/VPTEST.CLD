! Command table for recording how DCL parses command lines. The image,
! CLIDUMP, prints what CLI$PRESENT and CLI$GET_VALUE return.
MODULE VPT_TABLES
IDENT "V1.0"

DEFINE VERB VPTEST
	IMAGE "DKA200:[T.CLD]CLIDUMP.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="From",
		VALUE(REQUIRED, LIST, TYPE=$FILE)
	PARAMETER P2, LABEL=OUTPUT, PROMPT="To", VALUE(TYPE=$FILE)
	QUALIFIER LOG, NEGATABLE
	QUALIFIER CONFIRM, DEFAULT
	QUALIFIER COUNT, VALUE(TYPE=$NUMBER, DEFAULT="10")
	QUALIFIER NAME, VALUE(REQUIRED)
	QUALIFIER LIST, VALUE(LIST)
	QUALIFIER STYLE, VALUE(TYPE=STYLE_KW, LIST, DEFAULT="BRIEF")
	QUALIFIER OUTFILE, LABEL=OUT, VALUE(TYPE=$FILE)
	QUALIFIER SINCE, VALUE(TYPE=$DATETIME)
	QUALIFIER BEFORE, NONNEGATABLE
	QUALIFIER EXCLUDE, PLACEMENT=LOCAL, VALUE
	QUALIFIER BINARY, PLACEMENT=POSITIONAL
	QUALIFIER DELETE, SYNTAX=VPTEST_DELETE
	DISALLOW BEFORE AND SINCE
	DISALLOW NEG CONFIRM AND LOG

DEFINE SYNTAX VPTEST_DELETE
	PARAMETER P1, LABEL=TARGET, VALUE(REQUIRED)
	QUALIFIER DELETE
	QUALIFIER ALL

DEFINE TYPE STYLE_KW
	KEYWORD BRIEF, DEFAULT
	KEYWORD FULL
	KEYWORD COLUMNS, VALUE(TYPE=$NUMBER, REQUIRED)
	KEYWORD HEADER, NEGATABLE

DEFINE VERB VPTALK
	SYNONYM VPTX
	IMAGE "DKA200:[T.CLD]CLIDUMP.EXE"
	PARAMETER P1, LABEL=TEXT, VALUE(TYPE=$REST_OF_LINE)

DEFINE VERB VPCAT
	IMAGE "DKA200:[T.CLD]CLIDUMP.EXE"
	PARAMETER P1, LABEL=FILES, VALUE(REQUIRED, LIST, CONCATENATE)
	PARAMETER P2, LABEL=TITLE, VALUE(TYPE=$QUOTED_STRING)
	QUALIFIER WIDTH, VALUE(TYPE=$NUMBER)
	QUALIFIER PAGE, VALUE(TYPE=PAGE_KW)
	DISALLOW ANY2(WIDTH, PAGE.NONE)

DEFINE TYPE PAGE_KW
	KEYWORD NONE
	KEYWORD SIZE, VALUE(REQUIRED)
