$ DIRECTORY/FULL IM.DAT
$ WRITE SYS$OUTPUT "@@ DIRECTORY/FULL S.DAT"
$ DIRECTORY/FULL S.DAT
$ files = "S.DAT,R.DAT,RB.DAT,RV.DAT,I.DAT,IM.DAT,A.TXT;1,EMPTY.TXT,SUB.DIR"
$ items = "ALQ,BKS,BLS,CTG,DEQ,DIRECTORY,EOF,FFB,FSZ,GBC,KNOWN,LRL,MBM,MRN,MRS,NOA,NOK,ORG,PRO,PVN,RAT,RCK,RFM,UIC,WCK,ERASE,NOBACKUP,VERLIMIT,FILE_LENGTH_HINT,GBCFLAGS,GBC32,LOCKED,CBT,CDT"
$ j = 0
$ lf:
$ fn = F$ELEMENT(j, ",", files)
$ IF fn .EQS. "," THEN GOTO lfdone
$ WRITE SYS$OUTPUT "@@ lexicals ", fn
$ i = 0
$ li:
$ item = F$ELEMENT(i, ",", items)
$ IF item .EQS. "," THEN GOTO lidone
$ WRITE SYS$OUTPUT fn, " ", item, " ", F$FILE_ATTRIBUTES(fn, item)
$ i = i + 1
$ GOTO li
$ lidone:
$ j = j + 1
$ GOTO lf
$ lfdone:
$ WRITE SYS$OUTPUT "@@ lexical errors"
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("NOSUCH.DAT", "ORG")
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("S.DAT", "NOSUCHITEM")
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ end"
