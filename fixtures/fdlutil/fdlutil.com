$ WRITE SYS$OUTPUT "@@ DIRECTORY/SIZE=ALL *.DAT"
$ DIRECTORY/SIZE=ALL *.DAT
$ WRITE SYS$OUTPUT "@@ fill S.DAT"
$ OPEN/APPEND f S.DAT
$ n = 1
$ sl:
$ WRITE f F$FAO("sequential record !3ZL !#*-", n, n - (n / 7) * 7)
$ n = n + 1
$ IF n .LE. 60 THEN GOTO sl
$ CLOSE f
$ WRITE SYS$OUTPUT "@@ fill RB.DAT"
$ OPEN/APPEND f RB.DAT
$ n = 1
$ rl:
$ WRITE f F$FAO("relative !3ZL!28*.", n)
$ n = n + 1
$ IF n .LE. 50 THEN GOTO rl
$ CLOSE f
$ WRITE SYS$OUTPUT "@@ fill I.DAT"
$ OPEN/READ/WRITE f I.DAT
$ n = 1
$ il:
$ k = n * 37 - (n * 37 / 151) * 151
$ WRITE f F$FAO("!6ZL!8AS!16*x", k, F$ELEMENT(k - (k / 5) * 5, ",", "ALPHA,BRAVO,CHARLIE,DELTA,ECHO"))
$ n = n + 1
$ IF n .LE. 120 THEN GOTO il
$ CLOSE f
$ WRITE SYS$OUTPUT "@@ fill IM.DAT"
$ OPEN/READ/WRITE f IM.DAT
$ WRITE f "AAAA      BBBBtail one"
$ WRITE f "CCCC1234  DDDDtail two"
$ CLOSE f
