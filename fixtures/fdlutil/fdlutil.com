FILE
	ORGANIZATION	indexed
RECORD
	FORMAT		variable
	SIZE		80
AREA 0
	ALLOCATION	12
	BUCKET_SIZE	3
AREA 1
	ALLOCATION	6
	BUCKET_SIZE	2
AREA 2
	ALLOCATION	4
	BUCKET_SIZE	2
KEY 0
	DATA_AREA	0
	INDEX_AREA	1
	SEG0_LENGTH	4
	SEG0_POSITION	0
	SEG1_LENGTH	4
	SEG1_POSITION	10
KEY 1
	DATA_AREA	2
	INDEX_AREA	2
	DUPLICATES	yes
	CHANGES		yes
	SEG0_LENGTH	4
	SEG0_POSITION	4
	TYPE		int4
KEY 2
	DATA_AREA	2
	INDEX_AREA	2
	NULL_KEY	yes
	NULL_VALUE	32
	SEG0_LENGTH	2
	SEG0_POSITION	8
