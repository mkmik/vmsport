$ SET NOON
$ WRITE SYS$OUTPUT "@@ create"
$ CREATE/FDL=SYS$INPUT KEYED.DAT
FILE
	ORGANIZATION		indexed
RECORD
	FORMAT			fixed
	SIZE			20
KEY 0
	CHANGES			no
	DUPLICATES		no
	SEG0_LENGTH		4
	SEG0_POSITION		0
	TYPE			string
KEY 1
	CHANGES			yes
	DUPLICATES		yes
	SEG0_LENGTH		6
	SEG0_POSITION		4
	TYPE			string
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ write"
$ OPEN/READ/WRITE F KEYED.DAT
$ SHOW SYMBOL $STATUS
$ WRITE F "0030carrotthree     "
$ WRITE F "0010applesone       "
$ WRITE F "0020banan two       "
$ WRITE F "0040applesfour      "
$ SHOW SYMBOL $STATUS
$ WRITE F "0020dup             "
$ SHOW SYMBOL $STATUS
$ WRITE F "short"
$ SHOW SYMBOL $STATUS
$ WRITE F "0050this one is longer than twenty"
$ SHOW SYMBOL $STATUS
$ WRITE/ERROR=werr F "0020dup again       "
$ WRITE SYS$OUTPUT "not reached"
$ werr:
$ SHOW SYMBOL $STATUS
$ CLOSE F
$ WRITE SYS$OUTPUT "@@ sequential"
$ OPEN/READ F KEYED.DAT
$ loop1:
$ READ/END_OF_FILE=done1 F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ GOTO loop1
$ done1:
$ SHOW SYMBOL $STATUS
$ READ F r
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ keyed"
$ READ/KEY="0020" F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ READ F r
$ WRITE SYS$OUTPUT "next [", r, "]"
$ READ/KEY="0025" F r
$ SHOW SYMBOL $STATUS
$ READ/KEY="0025"/MATCH=GE F r
$ WRITE SYS$OUTPUT "GE [", r, "]"
$ READ/KEY="0030"/MATCH=GT F r
$ WRITE SYS$OUTPUT "GT [", r, "]"
$ READ/KEY="0030"/MATCH=GE F r
$ WRITE SYS$OUTPUT "GE [", r, "]"
$ READ/KEY="0030"/MATCH=LT F r
$ SHOW SYMBOL $STATUS
$ READ/KEY="0030"/MATCH=LE F r
$ SHOW SYMBOL $STATUS
$ READ/KEY="0030"/MATCH=EQ F r
$ WRITE SYS$OUTPUT "EQ [", r, "]"
$ READ/KEY="003" F r
$ WRITE SYS$OUTPUT "generic [", r, "]"
$ READ F r
$ WRITE SYS$OUTPUT "next [", r, "]"
$ READ/KEY="00300" F r
$ SHOW SYMBOL $STATUS
$ READ/KEY="" F r
$ SHOW SYMBOL $STATUS
$ READ/KEY="0050"/MATCH=GE F r
$ SHOW SYMBOL $STATUS
$ READ/ERROR=nf/KEY="9999" F r
$ WRITE SYS$OUTPUT "not reached"
$ nf:
$ SHOW SYMBOL $STATUS
$ READ/END_OF_FILE=eof2/KEY="9999" F r
$ WRITE SYS$OUTPUT "after RNF with /END_OF_FILE"
$ SHOW SYMBOL $STATUS
$ eof2:
$ WRITE SYS$OUTPUT "@@ alternate"
$ READ/INDEX=1/KEY="apples" F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ READ F r
$ WRITE SYS$OUTPUT "next [", r, "]"
$ READ F r
$ WRITE SYS$OUTPUT "next [", r, "]"
$ READ/INDEX=1/KEY="b" F r
$ WRITE SYS$OUTPUT "generic [", r, "]"
$ READ/INDEX=2/KEY="x" F r
$ SHOW SYMBOL $STATUS
$ READ/INDEX=1 F r
$ WRITE SYS$OUTPUT "index only [", r, "]"
$ READ/INDEX=0 F r
$ WRITE SYS$OUTPUT "index 0 [", r, "]"
$ CLOSE F
$ OPEN/READ F KEYED.DAT
$ READ/INDEX=1 F r
$ WRITE SYS$OUTPUT "first by index 1 [", r, "]"
$ loop2:
$ READ/END_OF_FILE=done2 F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ GOTO loop2
$ done2:
$ CLOSE F
$ WRITE SYS$OUTPUT "@@ update"
$ OPEN/READ/WRITE F KEYED.DAT
$ WRITE/UPDATE F "0010nothing read    "
$ SHOW SYMBOL $STATUS
$ READ/KEY="0010" F r
$ WRITE/UPDATE F "0010zebra one updated"
$ SHOW SYMBOL $STATUS
$ READ/KEY="0010" F r
$ WRITE/UPDATE F "0010zebra one upd   "
$ SHOW SYMBOL $STATUS
$ READ/KEY="0030" F r
$ WRITE/UPDATE F "0031carrotchanged pk"
$ SHOW SYMBOL $STATUS
$ READ/KEY="0020" F r
$ WRITE/UPDATE F "0020"
$ SHOW SYMBOL $STATUS
$ READ/DELETE/KEY="0040" F r
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "deleted [", r, "]"
$ READ/KEY="0040" F r
$ SHOW SYMBOL $STATUS
$ READ/KEY="0010" F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ WRITE F "0045new after delete "
$ SHOW SYMBOL $STATUS
$ READ F r
$ WRITE SYS$OUTPUT "next after write [", r, "]"
$ READ/DELETE F r
$ WRITE SYS$OUTPUT "deleted next [", r, "]"
$ READ F r
$ WRITE SYS$OUTPUT "then [", r, "]"
$ CLOSE F
$ WRITE SYS$OUTPUT "@@ share"
$ OPEN/READ/WRITE/SHARE=WRITE A KEYED.DAT
$ SHOW SYMBOL $STATUS
$ OPEN/READ/WRITE/SHARE=WRITE B KEYED.DAT
$ SHOW SYMBOL $STATUS
$ READ/KEY="0020" A r
$ READ/KEY="0020" B r
$ SHOW SYMBOL $STATUS
$ READ/NOLOCK/KEY="0020" B r
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "nolock [", r, "]"
$ READ/KEY="0045" A r
$ READ/KEY="0020" B r
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "B [", r, "]"
$ WRITE/UPDATE B "0020banana two      "
$ SHOW SYMBOL $STATUS
$ READ/KEY="0020" A r
$ SHOW SYMBOL $STATUS
$ READ/NOLOCK/KEY="0020" A r
$ WRITE SYS$OUTPUT "A sees [", r, "]"
$ CLOSE B
$ READ/KEY="0020" A r
$ SHOW SYMBOL $STATUS
$ CLOSE A
$ OPEN/READ/WRITE A KEYED.DAT
$ OPEN/READ B KEYED.DAT
$ SHOW SYMBOL $STATUS
$ OPEN/READ/ERROR=flk B KEYED.DAT
$ flk:
$ SHOW SYMBOL $STATUS
$ CLOSE A
$ OPEN/READ A KEYED.DAT
$ OPEN/READ B KEYED.DAT
$ SHOW SYMBOL $STATUS
$ OPEN/READ/WRITE C KEYED.DAT
$ SHOW SYMBOL $STATUS
$ CLOSE A
$ CLOSE B
$ CLOSE C
$ OPEN/READ/SHARE=READ A KEYED.DAT
$ OPEN/READ/SHARE=READ B KEYED.DAT
$ SHOW SYMBOL $STATUS
$ OPEN/READ/WRITE C KEYED.DAT
$ SHOW SYMBOL $STATUS
$ CLOSE A
$ CLOSE B
$ CLOSE C
$ WRITE SYS$OUTPUT "@@ relative"
$ CREATE/FDL=SYS$INPUT REL.DAT
FILE
	ORGANIZATION		relative
RECORD
	FORMAT			variable
	SIZE			40
$ OPEN/READ/WRITE F REL.DAT
$ WRITE F "first"
$ WRITE F "second"
$ WRITE F "third"
$ SHOW SYMBOL $STATUS
$ CLOSE F
$ OPEN/READ/WRITE F REL.DAT
$ READ/KEY="2" F r
$ SHOW SYMBOL $STATUS
$ READ F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ READ/DELETE F r
$ WRITE SYS$OUTPUT "deleted [", r, "]"
$ READ F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ WRITE/UPDATE F "third, updated and longer"
$ SHOW SYMBOL $STATUS
$ WRITE F "fourth"
$ SHOW SYMBOL $STATUS
$ CLOSE F
$ OPEN/READ F REL.DAT
$ loop3:
$ READ/END_OF_FILE=done3 F r
$ WRITE SYS$OUTPUT "[", r, "]"
$ GOTO loop3
$ done3:
$ CLOSE F
$ WRITE SYS$OUTPUT "@@ utilities"
$ TYPE KEYED.DAT
$ SHOW SYMBOL $STATUS
$ TYPE REL.DAT
$ SEARCH KEYED.DAT apples,zebra
$ SEARCH REL.DAT "th"
$ WRITE SYS$OUTPUT "@@ lexicals"
$ items = "ORG,RFM,RAT,MRS,MRN,BKS,NOK,NOA,FSZ,ALQ,EOF,DEQ,GBC,LRL"
$ i = 0
$ loop4:
$ item = F$ELEMENT(i, ",", items)
$ IF item .EQS. "," THEN GOTO done4
$ WRITE SYS$OUTPUT item, " ", F$FILE_ATTRIBUTES("KEYED.DAT", item), " ", F$FILE_ATTRIBUTES("REL.DAT", item)
$ i = i + 1
$ GOTO loop4
$ done4:
$ WRITE SYS$OUTPUT "@@ directory"
$ DIRECTORY/FULL KEYED.DAT,REL.DAT
$ WRITE SYS$OUTPUT "@@ end"
