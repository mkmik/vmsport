$! Logical names: DEFINE, ASSIGN, DEASSIGN, translation and devices.
$ SET NOON
$ DEFINE VPT_ONE "first value"
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_ONE"), "]"
$ DEFINE VPT_ONE second
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_ONE"), "] ", F$FAO("!XL", F$INTEGER($STATUS))
$ ASSIGN "assigned" VPT_TWO
$ WRITE SYS$OUTPUT "[", F$TRNLNM("vpt_two"), "]"
$ DEFINE VPT_LIST A, B, "c d"
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_LIST"), "|", F$TRNLNM("VPT_LIST",,1), "|", -
	F$TRNLNM("VPT_LIST",,2), "|", F$TRNLNM("VPT_LIST",,,,,"MAX_INDEX")
$ DEFINE/JOB VPT_JOB jobvalue
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_JOB"), " ", F$EXTRACT(0, 8, F$TRNLNM("VPT_JOB",,,,,"TABLE_NAME"))
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_JOB","LNM$PROCESS"), "|", F$TRNLNM("VPT_JOB","LNM$JOB")
$ DEFINE VPT_JOB processvalue
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_JOB"), " ", F$TRNLNM("VPT_JOB",,,,,"TABLE_NAME")
$ DEASSIGN VPT_JOB
$ WRITE SYS$OUTPUT F$TRNLNM("VPT_JOB")
$ DEASSIGN/JOB VPT_JOB
$ WRITE SYS$OUTPUT "[", F$TRNLNM("VPT_JOB"), "]"
$ DEASSIGN VPT_NOSUCH
$ WRITE SYS$OUTPUT "deassign missing ", F$FAO("!XL", F$INTEGER($STATUS))
$ SHOW LOGICAL VPT_ONE
$ SHOW LOGICAL VPT_LIST
$ SHOW LOGICAL VPT_NOSUCH
$ WRITE SYS$OUTPUT "show missing ", F$FAO("!XL", F$INTEGER($STATUS))
$ DEFINE/TRANSLATION=CONCEALED VPT_DEV DKA200:[T.DCL.]
$ WRITE SYS$OUTPUT F$PARSE("VPT_DEV:[SUB]X.Y")
$ DEFINE VPT_FILE VPT_DEV:[SUB]NAME.TXT
$ WRITE SYS$OUTPUT F$PARSE("VPT_FILE")
$ WRITE SYS$OUTPUT F$PARSE(".DAT","VPT_FILE")
$ OPEN/WRITE out VPT_DEV:[000000]VIALOG.TXT
$ WRITE out "via a logical"
$ CLOSE out
$ OPEN/READ in VIALOG.TXT
$ READ in line
$ CLOSE in
$ WRITE SYS$OUTPUT "[", line, "]"
$ DEFINE VPT_SL VPT_NOWHERE:, DKA200:[T.DCL]
$ WRITE SYS$OUTPUT F$SEARCH("VPT_SL:VIALOG.TXT") - "DKA200:[T.DCL]"
$ EXIT
