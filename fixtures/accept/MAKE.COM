$! The acceptance files as VMS makes them, then as UPDATE.COM leaves them.
$ SET NOON
$ CREATE/FDL=ORDERS.FDL ORDERS.DAT
$ CREATE/FDL=PARTS.FDL PARTS.DAT
$ OPEN/READ/WRITE f ORDERS.DAT
$ n = 1
$o_put:
$ k = n * 37 - (n * 37 / 311) * 311
$ @RECORDS ORDER 'k'
$ WRITE f REC
$ n = n + 1
$ IF n .LE. 310 THEN GOTO o_put
$ CLOSE f
$ OPEN/READ/WRITE f PARTS.DAT
$ n = 1
$p_put:
$ k = n * 23 - (n * 23 / 211) * 211
$ @RECORDS PART 'k'
$ WRITE f REC
$ n = n + 1
$ IF n .LE. 210 THEN GOTO p_put
$ CLOSE f
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=ORDERS.CHK ORDERS.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=ORDERS.ANL ORDERS.DAT
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=PARTS.CHK PARTS.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=PARTS.ANL PARTS.DAT
$ COPY ORDERS.DAT ORDERSU.DAT
$ COPY PARTS.DAT PARTSU.DAT
$ @UPDATE ORDERSU.DAT PARTSU.DAT
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=ORDERSU.CHK ORDERSU.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=ORDERSU.ANL ORDERSU.DAT
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=PARTSU.CHK PARTSU.DAT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=PARTSU.ANL PARTSU.DAT
$ @READS ORDERSU.DAT 3
$ @READS PARTSU.DAT 2
$! The first statuses DCL leaves on a sequential file, for DCL's sake.
$ OPEN/WRITE s SEQ.TXT
$ WRITE s "one"
$ CLOSE s
$ OPEN/READ s SEQ.TXT
$ SHOW SYMBOL $STATUS
$ READ s line
$ SHOW SYMBOL $STATUS
$ CLOSE s
