$ SET NOON
$ DEFINE SYS$SCRATCH 'F$ENVIRONMENT("DEFAULT")'
$ @GEN 10 G10.DAT 23
$ @GEN 20 G20.DAT 23
$ @GEN 34 G34.DAT 23
$ @GEN 35 G35.DAT 23
$ @GEN 100 G100.DAT 23
$ @GEN 300 G300.DAT 23
$ @GEN 1000 G1K.DAT 23
$ @GEN 100 H100.DAT 71
$ @GEN 100 K100.DAT 1
$ @GEN 3 G3.DAT 23
$ @GEN 1 G1.DAT 23
$ n = "G10,G20,G34,G35,G100,G300,G1K,H100,K100,G3,G1"
$ i = 0
$ loop:
$ f = F$ELEMENT(i, ",", n)
$ IF f .EQS. "," THEN GOTO done
$ WRITE SYS$OUTPUT "@@ ", f
$ SORT/KEY=(POSITION:7,SIZE:2)/STATISTICS 'f'.DAT S'f'.DAT
$ SHOW SYMBOL $STATUS
$ i = i + 1
$ GOTO loop
$ done:
$ WRITE SYS$OUTPUT "@@ G100 stable"
$ SORT/STABLE/KEY=(POSITION:7,SIZE:2)/STATISTICS G100.DAT SG100S.DAT
$ WRITE SYS$OUTPUT "@@ G100 nodup"
$ SORT/NODUPLICATES/KEY=(POSITION:7,SIZE:2)/STATISTICS G100.DAT SG100N.DAT
$ WRITE SYS$OUTPUT "@@ G100 desc"
$ SORT/KEY=(POSITION:7,SIZE:2,DESCENDING)/STATISTICS G100.DAT SG100D.DAT
$ WRITE SYS$OUTPUT "@@ G100 two keys"
$ SORT/KEY=(POSITION:7,SIZE:2)/KEY=(POSITION:5,SIZE:1)/STATISTICS G100.DAT SG100K.DAT
$ WRITE SYS$OUTPUT "@@ G100 whole"
$ SORT/STATISTICS G100.DAT SG100W.DAT
$ WRITE SYS$OUTPUT "@@ G100 binary"
$ SORT/KEY=(POSITION:7,SIZE:2,BINARY)/STATISTICS G100.DAT SG100B.DAT
$ WRITE SYS$OUTPUT "@@ G100 decimal"
$ SORT/KEY=(POSITION:7,SIZE:2,DECIMAL)/STATISTICS G100.DAT SG100Z.DAT
$ WRITE SYS$OUTPUT "@@ G100 tag"
$ SORT/PROCESS=TAG/KEY=(POSITION:7,SIZE:2)/STATISTICS G100.DAT SG100T.DAT
$ WRITE SYS$OUTPUT "@@ G1K merge"
$ SORT/KEY=(POSITION:7,SIZE:2)/STABLE G1K.DAT M1K.DAT
$ SORT/KEY=(POSITION:7,SIZE:2)/STABLE G100.DAT M100.DAT
$ MERGE/KEY=(POSITION:7,SIZE:2)/STATISTICS M1K.DAT,M100.DAT MM.DAT
$ WRITE SYS$OUTPUT "@@ IN decimal"
$ SORT/KEY=(POSITION:9,SIZE:4,DECIMAL)/STATISTICS IN.TXT SID.DAT
$ WRITE SYS$OUTPUT "@@ IN key"
$ SORT/KEY=(POSITION:9,SIZE:4)/STATISTICS IN.TXT SIK.DAT
$ WRITE SYS$OUTPUT "@@ IN binary"
$ SORT/KEY=(POSITION:1,SIZE:2,BINARY)/STATISTICS IN.TXT SIB.DAT
$ WRITE SYS$OUTPUT "@@ IN pos30"
$ SORT/KEY=(POSITION:30,SIZE:4)/STATISTICS IN.TXT SIP.DAT
$ WRITE SYS$OUTPUT "@@ IN nodup"
$ SORT/NODUPLICATES/KEY=(POSITION:1,SIZE:8)/STATISTICS IN.TXT SIN.DAT
$ TYPE SIN.DAT
$ WRITE SYS$OUTPUT "@@ IN key1-8"
$ SORT/KEY=(POSITION:1,SIZE:8)/STATISTICS IN.TXT SI8.DAT
$ TYPE SI8.DAT
$ WRITE SYS$OUTPUT "@@ end"
