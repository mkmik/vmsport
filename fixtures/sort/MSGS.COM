$ SET NOON
$ WRITE SYS$OUTPUT "@@ system"
$ CALL SCAN %X001C8000
$ CALL SCAN %X00B28000
$ CALL SCAN %X00B48000
$ loop:
$ f = F$SEARCH("SYS$MESSAGE:*.EXE")
$ IF f .EQS. "" THEN GOTO done
$ n = F$PARSE(f,,,"NAME")
$ IF F$LOCATE("CONV",n) .EQ. F$LENGTH(n) .AND. F$LOCATE("CVT",n) .EQ. F$LENGTH(n) .AND. -
	F$LOCATE("SORT",n) .EQ. F$LENGTH(n) .AND. F$LOCATE("FDL",n) .EQ. F$LENGTH(n) THEN GOTO loop
$ WRITE SYS$OUTPUT "@@ ", n
$ SET MESSAGE 'f'
$ CALL SCAN %X001C8000
$ CALL SCAN %X00B28000
$ CALL SCAN %X00B48000
$ SET MESSAGE/DELETE
$ GOTO loop
$ done:
$ WRITE SYS$OUTPUT "@@ end"
$ EXIT
$ SCAN: SUBROUTINE
$ i = 'P1'
$ e = i + %X400
$ l:
$ m = F$MESSAGE(i)
$ IF F$LOCATE("NOMSG",m) .EQ. F$LENGTH(m) THEN WRITE SYS$OUTPUT F$FAO("!XL ",i), m
$ i = i + 8
$ IF i .LT. e THEN GOTO l
$ ENDSUBROUTINE
