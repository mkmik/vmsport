$ SET NOON
$ DEFINE SYS$SCRATCH 'F$ENVIRONMENT("DEFAULT")'
$ WRITE SYS$OUTPUT "@@ default"
$ SORT IN.TXT S1.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S1.DAT
$ WRITE SYS$OUTPUT "@@ key"
$ SORT/KEY=(POSITION:9,SIZE:4) IN.TXT S2.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S2.DAT
$ WRITE SYS$OUTPUT "@@ descending"
$ SORT/KEY=(POSITION:9,SIZE:4,DESCENDING) IN.TXT S3.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S3.DAT
$ WRITE SYS$OUTPUT "@@ two keys"
$ SORT/KEY=(POSITION:1,SIZE:2)/KEY=(POSITION:14,SIZE:1,DESCENDING) IN.TXT S4.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S4.DAT
$ WRITE SYS$OUTPUT "@@ numbered keys"
$ SORT/KEY=(POSITION:14,SIZE:1,NUMBER:2)/KEY=(POSITION:1,SIZE:8,NUMBER:1) IN.TXT S5.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S5.DAT
$ WRITE SYS$OUTPUT "@@ stable"
$ SORT/STABLE/KEY=(POSITION:1,SIZE:8) IN.TXT S6.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S6.DAT
$ WRITE SYS$OUTPUT "@@ noduplicates"
$ SORT/NODUPLICATES/KEY=(POSITION:1,SIZE:8) IN.TXT S7.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S7.DAT
$ WRITE SYS$OUTPUT "@@ binary"
$ SORT/KEY=(POSITION:1,SIZE:2,BINARY) IN.TXT S8.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S8.DAT
$ SORT/KEY=(POSITION:1,SIZE:2,BINARY,UNSIGNED) IN.TXT S8U.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S8U.DAT
$ WRITE SYS$OUTPUT "@@ decimal"
$ SORT/KEY=(POSITION:9,SIZE:4,DECIMAL) IN.TXT S9.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S9.DAT
$ SORT/KEY=(POSITION:1,SIZE:5,DECIMAL,LEADING_SIGN,SEPARATE_SIGN) NUM.TXT S10.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S10.DAT
$ SORT/KEY=(POSITION:1,SIZE:5,DECIMAL) NUM.TXT S10B.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S10B.DAT
$ WRITE SYS$OUTPUT "@@ two inputs"
$ SORT IN.TXT,B.TXT S11.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S11.DAT
$ WRITE SYS$OUTPUT "@@ process"
$ SORT/PROCESS=TAG IN.TXT S12.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S12.DAT
$ SORT/PROCESS=RECORD IN.TXT S13.DAT
$ SHOW SYMBOL $STATUS
$ SORT/PROCESS=ADDRESS IN.TXT S14.DAT
$ SHOW SYMBOL $STATUS
$ SORT/PROCESS=INDEX/KEY=(POSITION:1,SIZE:4) IN.TXT S15.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ formats"
$ SORT IN.TXT S16.DAT/FORMAT=FIXED:20
$ SHOW SYMBOL $STATUS
$ TYPE S16.DAT
$ SORT IN.TXT S17.DAT/FORMAT=VARIABLE:30
$ SHOW SYMBOL $STATUS
$ TYPE S17.DAT
$ SORT IN.TXT S18.DAT/FORMAT=FIXED:10
$ SHOW SYMBOL $STATUS
$ TYPE S18.DAT
$ SORT IN.TXT S19.DAT/RELATIVE
$ SHOW SYMBOL $STATUS
$ TYPE S19.DAT
$ SORT IN.TXT S20.DAT/SEQUENTIAL/FORMAT=VARIABLE
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ overlay"
$ CREATE/FDL=IDX.FDL S21.DAT
$ SORT/KEY=(POSITION:1,SIZE:8) IN.TXT S21.DAT/INDEXED_SEQUENTIAL/OVERLAY
$ SHOW SYMBOL $STATUS
$ TYPE S21.DAT
$ SORT/KEY=(POSITION:1,SIZE:8) IN.TXT S22.DAT/INDEXED_SEQUENTIAL
$ SHOW SYMBOL $STATUS
$ CREATE/FDL=FIX20.FDL S23.DAT
$ SORT IN.TXT S23.DAT/OVERLAY
$ SHOW SYMBOL $STATUS
$ TYPE S23.DAT
$ WRITE SYS$OUTPUT "@@ statistics"
$ SORT/STATISTICS IN.TXT S24.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ errors"
$ SORT NOSUCH.TXT S25.DAT
$ SHOW SYMBOL $STATUS
$ SORT/KEY=(POSITION:0,SIZE:4) IN.TXT S26.DAT
$ SHOW SYMBOL $STATUS
$ SORT/KEY=(POSITION:30,SIZE:4) IN.TXT S27.DAT
$ SHOW SYMBOL $STATUS
$ TYPE S27.DAT
$ SORT/KEY=(SIZE:4) IN.TXT S28.DAT
$ SHOW SYMBOL $STATUS
$ SORT/KEY=(POSITION:1) IN.TXT S29.DAT
$ SHOW SYMBOL $STATUS
$ SORT/KEY=(POSITION:1,SIZE:300) IN.TXT S30.DAT
$ SHOW SYMBOL $STATUS
$ SORT/KEY=(POSITION:1,SIZE:4,BINARY) IN.TXT S31.DAT
$ SHOW SYMBOL $STATUS
$ SORT IN.TXT [.NODIR]S32.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ merge"
$ SORT IN.TXT M1.DAT
$ SORT B.TXT M2.DAT
$ MERGE M1.DAT,M2.DAT M3.DAT
$ SHOW SYMBOL $STATUS
$ TYPE M3.DAT
$ SORT/KEY=(POSITION:9,SIZE:4) IN.TXT M4.DAT
$ SORT/KEY=(POSITION:9,SIZE:4) B.TXT M5.DAT
$ MERGE/KEY=(POSITION:9,SIZE:4) M4.DAT,M5.DAT M6.DAT
$ SHOW SYMBOL $STATUS
$ TYPE M6.DAT
$ MERGE IN.TXT,B.TXT M7.DAT
$ SHOW SYMBOL $STATUS
$ TYPE M7.DAT
$ MERGE/CHECK_SEQUENCE IN.TXT,B.TXT M8.DAT
$ SHOW SYMBOL $STATUS
$ TYPE M8.DAT
$ MERGE/NOCHECK_SEQUENCE IN.TXT,B.TXT M9.DAT
$ SHOW SYMBOL $STATUS
$ TYPE M9.DAT
$ MERGE/NODUPLICATES M1.DAT,M2.DAT M10.DAT
$ SHOW SYMBOL $STATUS
$ TYPE M10.DAT
$ MERGE M1.DAT M11.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ end"
