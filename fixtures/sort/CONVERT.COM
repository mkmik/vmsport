$ SET NOON
$ DEFINE SYS$SCRATCH 'F$ENVIRONMENT("DEFAULT")'
$ WRITE SYS$OUTPUT "@@ copy"
$ CONVERT IN.TXT C1.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C1.DAT
$ WRITE SYS$OUTPUT "@@ fixed"
$ CONVERT/FDL=FIX20.FDL IN.TXT C2.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C2.DAT
$ CONVERT/FDL=FIX20.FDL/PAD IN.TXT C3.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C3.DAT
$ CONVERT/FDL=FIX20.FDL/PAD=%X2A/TRUNCATE IN.TXT C4.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C4.DAT
$ CONVERT/FDL=FIX20.FDL/TRUNCATE/EXCEPTIONS_FILE=C5.EXC IN.TXT C5.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C5.DAT
$ TYPE C5.EXC
$ CONVERT/FDL=FIX20.FDL/EXCEPTIONS_FILE IN.TXT C6.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C6.*
$ WRITE SYS$OUTPUT "@@ relative"
$ CONVERT/FDL=REL.FDL IN.TXT C7.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C7.DAT
$ CONVERT/FDL=SEQ.FDL C7.DAT C8.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C8.DAT
$ WRITE SYS$OUTPUT "@@ stream"
$ CONVERT/FDL=STM.FDL IN.TXT C9.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C9.DAT
$ WRITE SYS$OUTPUT "@@ indexed"
$ CONVERT/FDL=IDX.FDL IN.TXT C10.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C10.DAT
$ CONVERT/FDL=IDX.FDL/KEY=0 C10.DAT C11.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/KEY=1 C10.DAT C12.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C12.DAT
$ CONVERT/FDL=IDXND.FDL/PAD/TRUNCATE IN.TXT C13.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C13.DAT
$ CONVERT/FDL=IDXND.FDL/PAD/TRUNCATE/EXCEPTIONS_FILE=C14.EXC IN.TXT C14.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C14.EXC
$ CONVERT/FDL=IDX.FDL/NOSORT IN.TXT C15.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C15.DAT
$ CONVERT/FDL=IDX.FDL/NOFAST_LOAD IN.TXT C16.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ append"
$ CONVERT IN.TXT C17.DAT
$ CONVERT/APPEND B.TXT C17.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C17.DAT
$ DIRECTORY C17.DAT
$ WRITE SYS$OUTPUT "@@ nocreate"
$ CONVERT/FDL=FIX20.FDL/PAD IN.TXT C18.DAT
$ CONVERT/NOCREATE/PAD B.TXT C18.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C18.DAT
$ DIRECTORY C18.DAT
$ WRITE SYS$OUTPUT "@@ merge"
$ CONVERT/FDL=IDX.FDL IN.TXT C19.DAT
$ CONVERT/MERGE B.TXT C19.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C19.DAT
$ DIRECTORY C19.DAT
$ WRITE SYS$OUTPUT "@@ statistics"
$ CONVERT/STATISTICS IN.TXT C20.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/STATISTICS/FDL=IDX.FDL IN.TXT C21.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ two inputs"
$ CONVERT IN.TXT,B.TXT C22.DAT
$ SHOW SYMBOL $STATUS
$ TYPE C22.DAT
$ WRITE SYS$OUTPUT "@@ errors"
$ CONVERT NOSUCH.TXT C23.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=NOSUCH.FDL IN.TXT C24.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/NOCREATE IN.TXT NOSUCH.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/MERGE IN.TXT C1.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=FIX20.FDL/SHARE/READ_CHECK/WRITE_CHECK/FILL_BUCKETS/FIXED_CONTROL/PAD IN.TXT C25.DAT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "@@ end"
