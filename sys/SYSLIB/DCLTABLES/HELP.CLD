! HELP: topics from help libraries (the help image).
MODULE HELP_TABLES

DEFINE VERB HELP
	IMAGE "SYS$SYSTEM:HELP.EXE"
	PARAMETER P1, LABEL=TOPIC, VALUE(TYPE=$REST_OF_LINE)
	QUALIFIER LIBRARY, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER PROMPT, DEFAULT
	QUALIFIER INSTRUCTIONS, DEFAULT
	QUALIFIER OUTPUT, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER PAGE
	QUALIFIER USERLIBRARY, VALUE(LIST)
