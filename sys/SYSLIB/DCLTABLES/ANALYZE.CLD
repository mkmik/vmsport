! ANALYZE: vmsport's has /RMS_FILE only, its /CHECK and /FDL reports.
MODULE ANALYZE_TABLES

DEFINE VERB ANALYZE
	IMAGE "SYS$SYSTEM:ANALYZE.EXE"
	PARAMETER P1, LABEL=FILE, PROMPT="File", VALUE(REQUIRED, LIST, TYPE=$FILE)
	QUALIFIER RMS_FILE
	QUALIFIER CHECK
	QUALIFIER FDL
	QUALIFIER OUTPUT, VALUE(TYPE=$FILE)
