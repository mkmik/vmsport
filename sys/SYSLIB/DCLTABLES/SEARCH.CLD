! SEARCH files for strings.
MODULE SEARCH_TABLES

DEFINE VERB SEARCH
	IMAGE "SYS$SYSTEM:SEARCH.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="Files",
		VALUE(REQUIRED, LIST, TYPE=$FILE)
	PARAMETER P2, LABEL=STRINGS, PROMPT="Strings",
		VALUE(REQUIRED, LIST)
	QUALIFIER EXACT
	QUALIFIER HEADING, DEFAULT
	QUALIFIER LOG
	QUALIFIER NUMBERS
	QUALIFIER OUTPUT, VALUE(TYPE=$FILE), DEFAULT
	QUALIFIER MATCH, VALUE(REQUIRED, TYPE=MATCH_KW)
	QUALIFIER WINDOW, VALUE(LIST, TYPE=$NUMBER)
	QUALIFIER STATISTICS
	QUALIFIER EXCLUDE, VALUE(REQUIRED, LIST, TYPE=$FILE)

DEFINE TYPE MATCH_KW
	KEYWORD AND
	KEYWORD OR, DEFAULT
	KEYWORD NAND
	KEYWORD NOR
