! SORT and MERGE, one image as on VMS. Keys are given as on VMS,
! /KEY=(POSITION:n,SIZE:n,...), as many /KEY qualifiers as there are keys.
MODULE SORT_TABLES

DEFINE TYPE SORT_KEY
	KEYWORD POSITION, VALUE(REQUIRED, TYPE=$NUMBER)
	KEYWORD SIZE, VALUE(REQUIRED, TYPE=$NUMBER)
	KEYWORD NUMBER, VALUE(REQUIRED, TYPE=$NUMBER)
	KEYWORD ASCENDING
	KEYWORD DESCENDING
	KEYWORD CHARACTER
	KEYWORD BINARY
	KEYWORD DECIMAL
	KEYWORD PACKED_DECIMAL
	KEYWORD ZONED
	KEYWORD SIGNED
	KEYWORD UNSIGNED
	KEYWORD LEADING_SIGN
	KEYWORD TRAILING_SIGN
	KEYWORD OVERPUNCHED_SIGN
	KEYWORD SEPARATE_SIGN
DEFINE TYPE SORT_PROCESS
	KEYWORD RECORD
	KEYWORD TAG
	KEYWORD ADDRESS
	KEYWORD INDEX
DEFINE TYPE SORT_FORMAT
	KEYWORD FIXED, VALUE(TYPE=$NUMBER)
	KEYWORD VARIABLE, VALUE(TYPE=$NUMBER)
	KEYWORD CONTROLLED, VALUE(TYPE=$NUMBER)
	KEYWORD SIZE, VALUE(REQUIRED, TYPE=$NUMBER)
	KEYWORD BLOCK_SIZE, VALUE(REQUIRED, TYPE=$NUMBER)
	KEYWORD RECORD_SIZE, VALUE(REQUIRED, TYPE=$NUMBER)
	KEYWORD FILE_SIZE, VALUE(REQUIRED, TYPE=$NUMBER)

DEFINE VERB SORT
	IMAGE "SYS$SYSTEM:SORT.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="File",
		VALUE(REQUIRED, LIST, TYPE=$FILE)
	PARAMETER P2, LABEL=OUTPUT, PROMPT="Output", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER KEY, VALUE(REQUIRED, LIST, TYPE=SORT_KEY)
	QUALIFIER STABLE
	QUALIFIER DUPLICATES, DEFAULT
	QUALIFIER PROCESS, VALUE(REQUIRED, TYPE=SORT_PROCESS)
	QUALIFIER STATISTICS
	QUALIFIER WORK_FILES, VALUE(TYPE=$NUMBER)
	QUALIFIER COLLATING_SEQUENCE, VALUE(REQUIRED)
	QUALIFIER SPECIFICATION, VALUE(TYPE=$FILE)
	QUALIFIER FORMAT, VALUE(REQUIRED, LIST, TYPE=SORT_FORMAT),
		PLACEMENT=POSITIONAL
	QUALIFIER SEQUENTIAL, PLACEMENT=LOCAL
	QUALIFIER RELATIVE, PLACEMENT=LOCAL
	QUALIFIER INDEXED_SEQUENTIAL, PLACEMENT=LOCAL
	QUALIFIER OVERLAY, PLACEMENT=LOCAL
	QUALIFIER ALLOCATION, VALUE(REQUIRED, TYPE=$NUMBER), PLACEMENT=LOCAL
	QUALIFIER BUCKET_SIZE, VALUE(REQUIRED, TYPE=$NUMBER), PLACEMENT=LOCAL
	QUALIFIER CONTIGUOUS, PLACEMENT=LOCAL

DEFINE VERB MERGE
	IMAGE "SYS$SYSTEM:SORT.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="File",
		VALUE(REQUIRED, LIST, TYPE=$FILE)
	PARAMETER P2, LABEL=OUTPUT, PROMPT="Output", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER KEY, VALUE(REQUIRED, LIST, TYPE=SORT_KEY)
	QUALIFIER STABLE
	QUALIFIER DUPLICATES, DEFAULT
	QUALIFIER CHECK_SEQUENCE, DEFAULT
	QUALIFIER STATISTICS
	QUALIFIER COLLATING_SEQUENCE, VALUE(REQUIRED)
	QUALIFIER SPECIFICATION, VALUE(TYPE=$FILE)
	QUALIFIER FORMAT, VALUE(REQUIRED, LIST, TYPE=SORT_FORMAT),
		PLACEMENT=POSITIONAL
	QUALIFIER SEQUENTIAL, PLACEMENT=LOCAL
	QUALIFIER RELATIVE, PLACEMENT=LOCAL
	QUALIFIER INDEXED_SEQUENTIAL, PLACEMENT=LOCAL
	QUALIFIER OVERLAY, PLACEMENT=LOCAL
	QUALIFIER ALLOCATION, VALUE(REQUIRED, TYPE=$NUMBER), PLACEMENT=LOCAL
	QUALIFIER BUCKET_SIZE, VALUE(REQUIRED, TYPE=$NUMBER), PLACEMENT=LOCAL
	QUALIFIER CONTIGUOUS, PLACEMENT=LOCAL
