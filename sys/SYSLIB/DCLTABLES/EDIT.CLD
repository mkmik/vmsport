! EDIT: text files in EVE (EDIT/TPU, the default, as on VMS), and EDIT/FDL,
! of the FDL editor only its non-interactive optimizing
! (/NOINTERACTIVE/ANALYSIS=). /HOST edits in the host's editor.
MODULE EDIT_TABLES

DEFINE VERB EDIT
	IMAGE "SYS$SYSTEM:TPU.EXE"
	PARAMETER P1, LABEL=FILE, PROMPT="File", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER FDL, SYNTAX=EDIT_FDL
	QUALIFIER HOST, SYNTAX=EDIT_HOST
	QUALIFIER TPU, DEFAULT
	QUALIFIER EDT, SYNTAX=EDIT_EDT
	QUALIFIER READ_ONLY
	QUALIFIER OUTPUT, VALUE(TYPE=$FILE)
	QUALIFIER CREATE, DEFAULT
	QUALIFIER WRITE, DEFAULT
	QUALIFIER MODIFY, DEFAULT
	QUALIFIER DISPLAY, DEFAULT, VALUE
	QUALIFIER INITIALIZATION, VALUE(TYPE=$FILE)
	QUALIFIER JOURNAL, VALUE(TYPE=$FILE)
	QUALIFIER RECOVER
	QUALIFIER START_POSITION, VALUE(REQUIRED, LIST)
	QUALIFIER COMMAND, VALUE(TYPE=$FILE)
	QUALIFIER SECTION, VALUE(TYPE=$FILE)

DEFINE SYNTAX EDIT_HOST
	IMAGE "SYS$SYSTEM:HOSTEDIT.EXE"
	PARAMETER P1, LABEL=FILE, PROMPT="File", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER READ_ONLY
	QUALIFIER OUTPUT, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER CREATE, DEFAULT

DEFINE SYNTAX EDIT_EDT
	IMAGE "SYS$SYSTEM:EDT.EXE"
	PARAMETER P1, LABEL=FILE, PROMPT="File", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER COMMAND, VALUE(TYPE=$FILE), DEFAULT
	QUALIFIER JOURNAL, VALUE(TYPE=$FILE), DEFAULT
	QUALIFIER RECOVER
	QUALIFIER OUTPUT, VALUE(TYPE=$FILE)
	QUALIFIER READ_ONLY
	QUALIFIER CREATE, DEFAULT

DEFINE SYNTAX EDIT_FDL
	IMAGE "SYS$SYSTEM:EDF.EXE"
	PARAMETER P1, LABEL=FILE, PROMPT="File", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER ANALYSIS, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER EMPHASIS, VALUE(REQUIRED, TYPE=EDF_EMPHASIS)
	QUALIFIER GRANULARITY, VALUE(REQUIRED, TYPE=EDF_GRANULARITY)
	QUALIFIER INTERACTIVE, DEFAULT
	QUALIFIER OUTPUT, VALUE(TYPE=$FILE)
	QUALIFIER SCRIPT, VALUE(REQUIRED, TYPE=EDF_SCRIPT)
	DISALLOW SCRIPT AND NEG INTERACTIVE

DEFINE TYPE EDF_EMPHASIS
	KEYWORD FLATTER_FILES
	KEYWORD SMALLER_BUFFERS
DEFINE TYPE EDF_GRANULARITY
	KEYWORD 1
	KEYWORD 2
	KEYWORD 3
	KEYWORD 4
DEFINE TYPE EDF_SCRIPT
	KEYWORD ADD_KEY
	KEYWORD DELETE_KEY
	KEYWORD INDEXED
	KEYWORD OPTIMIZE
	KEYWORD RELATIVE
	KEYWORD SEQUENTIAL
	KEYWORD TOUCHUP
