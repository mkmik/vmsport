! EDIT: in vmsport only EDIT/FDL, and of the FDL editor only its
! non-interactive optimizing (/NOINTERACTIVE/ANALYSIS=).
MODULE EDIT_TABLES

DEFINE VERB EDIT
	IMAGE "SYS$SYSTEM:EDF.EXE"
	PARAMETER P1, LABEL=FILE, PROMPT="File", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER FDL, SYNTAX=EDIT_FDL

DEFINE SYNTAX EDIT_FDL
	IMAGE "SYS$SYSTEM:EDF.EXE"
	PARAMETER P1, LABEL=FILE, PROMPT="File", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER ANALYSIS, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER EMPHASIS, VALUE(REQUIRED, TYPE=EDF_EMPHASIS)
	QUALIFIER GRANULARITY, VALUE(REQUIRED, TYPE=EDF_GRANULARITY)
	QUALIFIER INTERACTIVE, DEFAULT
	QUALIFIER OUTPUT, VALUE(TYPE=$FILE)
	QUALIFIER SCRIPT, VALUE(REQUIRED, TYPE=EDF_SCRIPT)
	DISALLOW SCRIPT AND NEG INTERACTIVE

DEFINE TYPE EDF_EMPHASIS
	KEYWORD FLATTER_FILES
	KEYWORD SMALLER_BUFFERS
DEFINE TYPE EDF_GRANULARITY
	KEYWORD 1
	KEYWORD 2
	KEYWORD 3
	KEYWORD 4
DEFINE TYPE EDF_SCRIPT
	KEYWORD ADD_KEY
	KEYWORD DELETE_KEY
	KEYWORD INDEXED
	KEYWORD OPTIMIZE
	KEYWORD RELATIVE
	KEYWORD SEQUENTIAL
	KEYWORD TOUCHUP
