! DIRECTORY: list files.
MODULE DIRECTORY_TABLES

DEFINE VERB DIRECTORY
	IMAGE "SYS$SYSTEM:DIRECTORY.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="File", VALUE(LIST, TYPE=$FILE)
	QUALIFIER BRIEF, DEFAULT
	QUALIFIER COLUMNS, VALUE(REQUIRED, TYPE=$NUMBER)
	QUALIFIER DATE, VALUE(LIST, TYPE=DATE_KW)
	QUALIFIER FULL
	QUALIFIER GRAND_TOTAL
	QUALIFIER HEADING, DEFAULT
	QUALIFIER OWNER
	QUALIFIER PROTECTION
	QUALIFIER SIZE, VALUE(TYPE=SIZE_KW)
	QUALIFIER TOTAL
	QUALIFIER TRAILING, DEFAULT
	QUALIFIER VERSIONS, VALUE(REQUIRED, TYPE=$NUMBER)
	QUALIFIER OUTPUT, VALUE(TYPE=$FILE)
	QUALIFIER EXCLUDE, VALUE(REQUIRED, LIST, TYPE=$FILE)

DEFINE TYPE SIZE_KW
	KEYWORD ALL
	KEYWORD ALLOCATION
	KEYWORD USED

DEFINE TYPE DATE_KW
	KEYWORD CREATED, DEFAULT
	KEYWORD MODIFIED
	KEYWORD ALL
