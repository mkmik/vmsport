! MOUNT: a Files-11 image file as a disk device. vmsport's form names the
! image first, where VMS has a drive: MOUNT image device [label] [logical].
MODULE MOUNT_TABLES

DEFINE VERB MOUNT
	IMAGE "SYS$SYSTEM:MOUNT.EXE"
	PARAMETER P1, LABEL=IMAGE, PROMPT="Image file", VALUE(REQUIRED, TYPE=$FILE)
	PARAMETER P2, LABEL=DEVICE, PROMPT="Device", VALUE(REQUIRED)
	PARAMETER P3, LABEL=VOLUME_LABEL
	PARAMETER P4, LABEL=LOGICAL_NAME
	QUALIFIER WRITE, DEFAULT
	QUALIFIER OVERRIDE, VALUE(LIST)
