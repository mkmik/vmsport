! COPY files.
MODULE COPY_TABLES

DEFINE VERB COPY
	IMAGE "SYS$SYSTEM:COPY.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="From",
		VALUE(REQUIRED, LIST, TYPE=$FILE)
	PARAMETER P2, LABEL=OUTPUT, PROMPT="To", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER LOG
	QUALIFIER CONCATENATE
	QUALIFIER EXCLUDE, VALUE(REQUIRED, LIST, TYPE=$FILE)
