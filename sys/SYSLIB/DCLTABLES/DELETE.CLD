! DELETE files (the DELETE image), or symbols (DCL itself, /SYMBOL).
MODULE DELETE_TABLES

DEFINE VERB DELETE
	IMAGE "SYS$SYSTEM:DELETE.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="File",
		VALUE(REQUIRED, LIST, TYPE=$FILE)
	QUALIFIER LOG
	QUALIFIER CONFIRM
	QUALIFIER SYMBOL, SYNTAX=DELETE_SYMBOL
	QUALIFIER BEFORE, VALUE(TYPE=$DATETIME)
	QUALIFIER SINCE, VALUE(TYPE=$DATETIME)
	QUALIFIER EXCLUDE, VALUE(REQUIRED, LIST, TYPE=$FILE)

DEFINE SYNTAX DELETE_SYMBOL
	ROUTINE DELETE_SYMBOL
	PARAMETER P1, LABEL=SYMBOL, PROMPT="Symbol"
	QUALIFIER SYMBOL
	QUALIFIER LOCAL
	QUALIFIER GLOBAL
	QUALIFIER ALL
	QUALIFIER LOG
