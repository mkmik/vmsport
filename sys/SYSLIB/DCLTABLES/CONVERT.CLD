! CONVERT: records from files of any organization into a file of any
! organization and format, as an FDL file or the first input describes it.
MODULE CONVERT_TABLES

DEFINE TYPE CONVERT_STATISTICS
	KEYWORD BRIEF, DEFAULT
	KEYWORD FULL

DEFINE VERB CONVERT
	IMAGE "SYS$SYSTEM:CONVERT.EXE"
	PARAMETER P1, LABEL=INPUT, PROMPT="Input file",
		VALUE(REQUIRED, LIST, TYPE=$FILE)
	PARAMETER P2, LABEL=OUTPUT, PROMPT="Output file", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER APPEND
	QUALIFIER CREATE, DEFAULT
	QUALIFIER EXCEPTIONS_FILE, VALUE(TYPE=$FILE)
	QUALIFIER EXIT
	QUALIFIER FAST_LOAD, DEFAULT
	QUALIFIER FDL, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER FILL_BUCKETS
	QUALIFIER FIXED_CONTROL
	QUALIFIER KEY, VALUE(REQUIRED, TYPE=$NUMBER)
	QUALIFIER MERGE
	QUALIFIER PAD, VALUE
	QUALIFIER PROLOG, VALUE(REQUIRED, TYPE=$NUMBER)
	QUALIFIER READ_CHECK
	QUALIFIER SECONDARY, VALUE(REQUIRED, TYPE=$NUMBER)
	QUALIFIER SHARE
	QUALIFIER SORT, DEFAULT
	QUALIFIER STATISTICS, VALUE(TYPE=CONVERT_STATISTICS)
	QUALIFIER TRUNCATE
	QUALIFIER WORK_FILES, VALUE(REQUIRED, TYPE=$NUMBER)
	QUALIFIER WRITE_CHECK
