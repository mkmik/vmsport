! Verbs DCL does itself. ROUTINE names the handler in vms-dcl; these verbs
! take their arguments as $REST_OF_LINE where DCL parses them as expressions.
MODULE DCL_TABLES

DEFINE VERB IF
	ROUTINE IF
	PARAMETER P1, VALUE(REQUIRED, TYPE=$REST_OF_LINE)
DEFINE VERB THEN
	ROUTINE THEN
	PARAMETER P1, VALUE(TYPE=$REST_OF_LINE)
DEFINE VERB ELSE
	ROUTINE ELSE
	PARAMETER P1, VALUE(TYPE=$REST_OF_LINE)
DEFINE VERB ENDIF
	ROUTINE ENDIF
DEFINE VERB GOTO
	ROUTINE GOTO
	PARAMETER P1, LABEL=LABEL, PROMPT="Label", VALUE(REQUIRED)
DEFINE VERB GOSUB
	ROUTINE GOSUB
	PARAMETER P1, LABEL=LABEL, PROMPT="Label", VALUE(REQUIRED)
DEFINE VERB RETURN
	ROUTINE RETURN
	PARAMETER P1, LABEL=STATUS, VALUE(TYPE=$REST_OF_LINE)
DEFINE VERB EXIT
	ROUTINE EXIT
	PARAMETER P1, LABEL=STATUS, VALUE(TYPE=$REST_OF_LINE)
DEFINE VERB STOP
	ROUTINE STOP
DEFINE VERB CALL
	ROUTINE CALL
	PARAMETER P1, LABEL=ARGS, PROMPT="Label", VALUE(REQUIRED, TYPE=$REST_OF_LINE)
DEFINE VERB SUBROUTINE
	ROUTINE SUBROUTINE
DEFINE VERB ENDSUBROUTINE
	ROUTINE ENDSUBROUTINE
DEFINE VERB ON
	ROUTINE ON
	PARAMETER P1, LABEL=ACTION, VALUE(REQUIRED, TYPE=$REST_OF_LINE)
DEFINE VERB CONTINUE
	ROUTINE CONTINUE
DEFINE VERB LOGOUT
	ROUTINE LOGOUT
	QUALIFIER BRIEF
	QUALIFIER FULL
DEFINE VERB EOJ
	ROUTINE LOGOUT

DEFINE VERB SPAWN
	ROUTINE SPAWN
	PARAMETER P1, LABEL=COMMAND, VALUE(TYPE=$REST_OF_LINE)
	QUALIFIER WAIT, DEFAULT
	QUALIFIER LOG, DEFAULT
	QUALIFIER SYMBOL, DEFAULT
	QUALIFIER LOGICAL_NAMES, DEFAULT
	QUALIFIER OUTPUT, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER INPUT, VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER PROCESS, VALUE(REQUIRED)
	QUALIFIER NOTIFY
	QUALIFIER CARRIAGE_CONTROL, DEFAULT
	QUALIFIER KEYPAD, DEFAULT
DEFINE VERB PIPE
	ROUTINE PIPE
	PARAMETER P1, LABEL=COMMAND, PROMPT="Command", VALUE(REQUIRED, TYPE=$REST_OF_LINE)

DEFINE VERB WRITE
	ROUTINE WRITE
	PARAMETER P1, LABEL=LOGICAL, PROMPT="Log_name", VALUE(REQUIRED)
	PARAMETER P2, LABEL=EXPRESSION, PROMPT="Expression", VALUE(REQUIRED, TYPE=$REST_OF_LINE)
	QUALIFIER SYMBOL
	QUALIFIER UPDATE
	QUALIFIER ERROR, VALUE(REQUIRED)
DEFINE VERB READ
	ROUTINE READ
	PARAMETER P1, LABEL=LOGICAL, PROMPT="Log_name", VALUE(REQUIRED)
	PARAMETER P2, LABEL=SYMBOL, PROMPT="Symbol", VALUE(REQUIRED)
	QUALIFIER END_OF_FILE, VALUE(REQUIRED)
	QUALIFIER ERROR, VALUE(REQUIRED)
	QUALIFIER PROMPT, VALUE(REQUIRED)
	QUALIFIER KEY, VALUE(REQUIRED)
	QUALIFIER INDEX, VALUE(REQUIRED, TYPE=$NUMBER)
	QUALIFIER DELETE
	QUALIFIER NOLOCK
	QUALIFIER TIME_OUT, VALUE(REQUIRED, TYPE=$NUMBER)
DEFINE VERB OPEN
	ROUTINE OPEN
	PARAMETER P1, LABEL=LOGICAL, PROMPT="Log_name", VALUE(REQUIRED)
	PARAMETER P2, LABEL=FILE, PROMPT="Filename", VALUE(REQUIRED, TYPE=$FILE)
	QUALIFIER READ
	QUALIFIER WRITE
	QUALIFIER APPEND
	QUALIFIER SHARE, VALUE
	QUALIFIER ERROR, VALUE(REQUIRED)
DEFINE VERB CLOSE
	ROUTINE CLOSE
	PARAMETER P1, LABEL=LOGICAL, PROMPT="Log_name", VALUE(REQUIRED)
	QUALIFIER ERROR, VALUE(REQUIRED)
	QUALIFIER DISPOSITION, VALUE(REQUIRED)
DEFINE VERB INQUIRE
	ROUTINE INQUIRE
	PARAMETER P1, LABEL=SYMBOL, PROMPT="Symbol", VALUE(REQUIRED)
	PARAMETER P2, LABEL=PROMPT, VALUE(TYPE=$REST_OF_LINE)
	QUALIFIER LOCAL
	QUALIFIER GLOBAL
	QUALIFIER PUNCTUATION, DEFAULT

DEFINE VERB DEFINE
	ROUTINE DEFINE
	PARAMETER P1, LABEL=LOGICAL, PROMPT="Log_name", VALUE(REQUIRED)
	PARAMETER P2, LABEL=EQUIVALENCE, PROMPT="Equ_name", VALUE(REQUIRED, LIST, TYPE=$FILE)
	QUALIFIER TABLE, VALUE(REQUIRED)
	QUALIFIER PROCESS
	QUALIFIER JOB
	QUALIFIER GROUP
	QUALIFIER SYSTEM
	QUALIFIER TRANSLATION_ATTRIBUTES, VALUE(REQUIRED, LIST, TYPE=TRANSLATION_KW)
	QUALIFIER LOG, DEFAULT
	QUALIFIER USER_MODE
	QUALIFIER SUPERVISOR_MODE
	QUALIFIER EXECUTIVE_MODE
	QUALIFIER KERNEL_MODE
DEFINE VERB ASSIGN
	ROUTINE ASSIGN
	PARAMETER P1, LABEL=EQUIVALENCE, PROMPT="Equ_name", VALUE(REQUIRED, LIST, TYPE=$FILE)
	PARAMETER P2, LABEL=LOGICAL, PROMPT="Log_name", VALUE(REQUIRED)
	QUALIFIER TABLE, VALUE(REQUIRED)
	QUALIFIER PROCESS
	QUALIFIER JOB
	QUALIFIER GROUP
	QUALIFIER SYSTEM
	QUALIFIER TRANSLATION_ATTRIBUTES, VALUE(REQUIRED, LIST, TYPE=TRANSLATION_KW)
	QUALIFIER LOG, DEFAULT
	QUALIFIER USER_MODE
	QUALIFIER SUPERVISOR_MODE
	QUALIFIER EXECUTIVE_MODE
	QUALIFIER KERNEL_MODE
DEFINE TYPE TRANSLATION_KW
	KEYWORD CONCEALED
	KEYWORD TERMINAL
DEFINE VERB DEASSIGN
	ROUTINE DEASSIGN
	PARAMETER P1, LABEL=LOGICAL, PROMPT="Log_name"
	QUALIFIER TABLE, VALUE(REQUIRED)
	QUALIFIER PROCESS
	QUALIFIER JOB
	QUALIFIER GROUP
	QUALIFIER SYSTEM
	QUALIFIER ALL
	QUALIFIER USER_MODE
	QUALIFIER SUPERVISOR_MODE
	QUALIFIER EXECUTIVE_MODE
	QUALIFIER KERNEL_MODE

DEFINE VERB SET
	ROUTINE SET
	PARAMETER P1, LABEL=OPTION, PROMPT="What", VALUE(REQUIRED, TYPE=SET_OPTIONS)
DEFINE TYPE SET_OPTIONS
	KEYWORD DEFAULT, SYNTAX=SET_DEFAULT
	KEYWORD VERIFY, NEGATABLE
	KEYWORD ON, NEGATABLE
	KEYWORD MESSAGE, SYNTAX=SET_MESSAGE
	KEYWORD COMMAND, SYNTAX=SET_COMMAND
	KEYWORD SYMBOL, SYNTAX=SET_SYMBOL
DEFINE SYNTAX SET_DEFAULT
	ROUTINE SET_DEFAULT
	PARAMETER P1, LABEL=OPTION, VALUE(REQUIRED)
	PARAMETER P2, LABEL=DIRECTORY, PROMPT="Directory", VALUE(REQUIRED, TYPE=$FILE)
DEFINE SYNTAX SET_MESSAGE
	ROUTINE SET_MESSAGE
	PARAMETER P1, LABEL=OPTION, VALUE(REQUIRED)
	PARAMETER P2, LABEL=FILE, VALUE(TYPE=$FILE)
	QUALIFIER FACILITY
	QUALIFIER IDENTIFICATION
	QUALIFIER SEVERITY
	QUALIFIER TEXT
	QUALIFIER DELETE
DEFINE SYNTAX SET_COMMAND
	ROUTINE SET_COMMAND
	PARAMETER P1, LABEL=OPTION, VALUE(REQUIRED)
	PARAMETER P2, LABEL=FILE, PROMPT="File", VALUE(LIST, TYPE=$FILE)
	QUALIFIER DELETE, VALUE(REQUIRED, LIST)
	QUALIFIER OBJECT, VALUE(TYPE=$FILE)
DEFINE SYNTAX SET_SYMBOL
	ROUTINE SET_SYMBOL
	PARAMETER P1, LABEL=OPTION, VALUE(REQUIRED)
	QUALIFIER SCOPE, VALUE(REQUIRED, LIST)
	QUALIFIER VERB
	QUALIFIER GENERAL

DEFINE VERB SHOW
	ROUTINE SHOW
	PARAMETER P1, LABEL=OPTION, PROMPT="What", VALUE(REQUIRED, TYPE=SHOW_OPTIONS)
DEFINE TYPE SHOW_OPTIONS
	KEYWORD SYMBOL, SYNTAX=SHOW_SYMBOL
	KEYWORD DEFAULT
	KEYWORD LOGICAL, SYNTAX=SHOW_LOGICAL
	KEYWORD TRANSLATION, SYNTAX=SHOW_TRANSLATION
	KEYWORD TIME
	KEYWORD STATUS
DEFINE SYNTAX SHOW_SYMBOL
	ROUTINE SHOW_SYMBOL
	PARAMETER P1, LABEL=OPTION, VALUE(REQUIRED)
	PARAMETER P2, LABEL=NAME, VALUE
	QUALIFIER LOCAL
	QUALIFIER GLOBAL
	QUALIFIER ALL
	QUALIFIER LOG
DEFINE SYNTAX SHOW_LOGICAL
	ROUTINE SHOW_LOGICAL
	PARAMETER P1, LABEL=OPTION, VALUE(REQUIRED)
	PARAMETER P2, LABEL=NAME, VALUE(LIST)
	QUALIFIER PROCESS
	QUALIFIER JOB
	QUALIFIER GROUP
	QUALIFIER SYSTEM
	QUALIFIER TABLE, VALUE(REQUIRED, LIST)
	QUALIFIER FULL
	QUALIFIER ALL
DEFINE SYNTAX SHOW_TRANSLATION
	ROUTINE SHOW_TRANSLATION
	PARAMETER P1, LABEL=OPTION, VALUE(REQUIRED)
	PARAMETER P2, LABEL=NAME, PROMPT="Log_name", VALUE(REQUIRED)
	QUALIFIER TABLE, VALUE(REQUIRED)
